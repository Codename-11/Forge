{
  "name": "@axiom-labs/forge-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Forge CLI + local daemon. Auto-detects local agent CLIs, registers a Runtime, and bridges chat/dispatch events to the right provider.",
  "type": "module",
  "bin": {
    "forge": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "eventsource": "^2.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

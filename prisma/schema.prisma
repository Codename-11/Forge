// Forge — project management schema
//
// Normalized relational model:
//   - Identity: User, Account, Session, VerificationToken (NextAuth)
//   - Tenancy:  Workspace + Membership (role-based access control)
//   - Work:     Project -> Issue -> (sub) Task ; Label, Status, Priority
//   - Social:   Comment, Reaction, Attachment
//   - Audit:    AuditLog, ActivityEvent (analytics source-of-truth)
//   - Plugins:  Plugin, Skill, ApiKey, Webhook, WebhookDelivery
//   - Metrics:  MetricAggregate (denormalized rollups)
//
// All tenant-scoped rows carry workspaceId for row-level isolation.
// Soft-delete: `deletedAt`; hard-delete only at workspace boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

/// Instance-wide role, distinct from the per-workspace {@link Role}. An
/// INSTANCE_ADMIN administers the whole self-hosted instance (tenants,
/// users, instance-wide runtimes, audit, system info) and can create
/// global {@link AgentProfile} rows, mark them instance-shared, and
/// force-disable them. Everyone else is MEMBER at the instance level
/// regardless of how many workspaces they own. Replaces the env-only
/// `ADMIN_EMAIL` gate (kept as a bootstrap fallback in trpc.ts).
enum InstanceRole {
  INSTANCE_ADMIN
  MEMBER
}

/// OAuth/identity provider kind for a {@link Connection}. Mirrors the
/// generic-first approach of {@link SsoType}: OIDC covers any OpenID-
/// Connect IdP (Authelia, Authentik, Keycloak, Okta, …); GITHUB / GOOGLE
/// / SLACK are first-party shapes; CUSTOM is a freeform/manual identity.
enum ConnectionProvider {
  OIDC
  GITHUB
  GOOGLE
  SLACK
  CUSTOM
}

/// Health of a {@link Connection}'s stored credential.
enum ConnectionStatus {
  CONNECTED
  DEGRADED
  DISCONNECTED
}

/// Sign-in provider kind for {@link SsoProvider}. OIDC is the generic,
/// discovery-based type that covers any OpenID-Connect IdP (Authelia,
/// Authentik, Keycloak, Okta, Azure AD, …). GITHUB / GOOGLE are the two
/// first-party OAuth providers, kept distinct so they map onto NextAuth's
/// built-in provider factories instead of generic OIDC discovery.
enum SsoType {
  OIDC
  GITHUB
  GOOGLE
}

enum WorkItemKind {
  EPIC
  ISSUE
  TASK
}

/// Workspace-level default for new issue human assignees.
/// NONE leaves issues unassigned, CREATOR assigns the issue author, and
/// USER assigns the configured workspace member.
enum DefaultIssueAssigneeMode {
  NONE
  CREATOR
  USER
}

/// Linear-style state machine with user-extensible statuses per workspace.
/// The enum is a *category*; the Status row holds the name, color, order.
enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PluginScope {
  READ_ISSUES
  WRITE_ISSUES
  READ_PROJECTS
  WRITE_PROJECTS
  READ_COMMENTS
  WRITE_COMMENTS
  READ_USERS
  READ_ANALYTICS
  SUBSCRIBE_EVENTS
  INVOKE_SKILLS
  ADMIN
}

enum PluginStatus {
  PENDING
  APPROVED
  SUSPENDED
  REVOKED
}

enum EventKind {
  ISSUE_CREATED
  ISSUE_UPDATED
  ISSUE_DELETED
  ISSUE_STATUS_CHANGED
  ISSUE_ASSIGNED
  ISSUE_PRIORITY_CHANGED
  ISSUE_QUEUED
  COMMENT_CREATED
  COMMENT_UPDATED
  PROJECT_CREATED
  PROJECT_UPDATED
  SKILL_INVOKED
  PLUGIN_ERROR
  AGENT_CREATED
  AGENT_UPDATED
  AGENT_DELETED
  AGENT_ASSIGNED
  AGENT_STATUS_CHANGED
  MEMBERSHIP_CREATED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_REMOVED
  ISSUE_STALLED
  AGENT_NOACK
  ISSUE_SLA_BREACH
  AGENT_RUN_STARTED
  AGENT_RUN_STEP
  AGENT_RUN_BLOCKED
  AGENT_RUN_COMPLETED
  AGENT_RUN_STALLED
  AGENT_RUN_CLEARED
  CHAT_MESSAGE_POSTED
  CHAT_THREAD_COMPACTED
  ISSUE_SNOOZED
  ISSUE_UNSNOOZED
  ISSUE_NUDGED
  AGENT_RUN_CONTROL_REQUESTED
  AGENT_RUN_KICKED
  /// Run crossed `runBudgetWarnPct` of a set budget (one-time, advisory).
  AGENT_RUN_BUDGET_WARNING
  /// Run breached a budget and was paused/stopped by the watchdog.
  AGENT_RUN_BUDGET_BREACHED
  GOAL_CREATED
  GOAL_STATUS_CHANGED
  EXECUTION_STEP_READY
  EXECUTION_STEP_JUDGED
  PLAN_BUDGET_EXCEEDED
}

/// Operator-requested control on an in-flight AgentRun. NONE is the
/// default steady state; PAUSE_REQUESTED / CANCEL_REQUESTED are
/// pending signals the agent's own runtime is expected to honor on
/// its next loop tick. Cleared by the runtime when it acts (or by
/// a follow-up `requestPause` flipping back to NONE).
enum AgentRunControlState {
  NONE
  PAUSE_REQUESTED
  CANCEL_REQUESTED
}

/// What the run-budget watchdog does when a run breaches its workspace
/// token / cost / wall-clock budget (added 2026-06-23). PAUSE is the
/// safe default: the provider run is stopped (best-effort) and the
/// AgentRun is parked in WAITING with a clear reason + an actionable
/// notification, so the operator can raise the budget and resume or
/// abandon — never a silently-dangling run. STOP closes the run as
/// ABANDONED outright. Budgets are opt-in (null/0 = unlimited).
enum RunBudgetAction {
  PAUSE
  STOP
}

enum ChatRole {
  USER
  AGENT
  SYSTEM
}

enum ChatContextMode {
  SMART
  RECENT_ONLY
  FULL_SUMMARY
  PINNED_CONTEXT
}

/// Polymorphic target for personal pins + recent-item tracking.
/// Each value names an entity kind in the system that can be pinned
/// to the sidebar or surfaced in the recent-items rail. Adding a
/// new value requires a Pin/RecentItem hydration branch in the
/// corresponding router.
enum PinTargetType {
  ISSUE
  PROJECT
  INITIATIVE
  SAVED_VIEW
  CYCLE
  AGENT
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
  ACKNOWLEDGED
  RESOLVED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  DEAD_LETTER
}

enum CycleStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

enum InitiativeStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

enum RelationKind {
  BLOCKS
  BLOCKED_BY
  DUPLICATES
  RELATES_TO
}

enum AgentStatus {
  ONLINE
  OFFLINE
  BUSY
}

/// Distinguishes humans-in-the-loop from intelligence helpers. WORKER is
/// the default and the only role auto-dispatch picks up. COACH agents
/// observe events (stalls, no-acks, breaches) and post diagnostic
/// comments — they don't claim work. OBSERVER is for read-only audit /
/// notification bots that should never receive dispatches.
enum AgentRole {
  WORKER
  COACH
  OBSERVER
}

/// Runtime/provider family for a registered agent. Hermes remains the
/// first-class persistent runtime; Claude/Codex currently operate as
/// single-session MCP clients unless a custom bridge is supplied.
enum AgentProvider {
  HERMES
  CLAUDE
  CODEX
  CUSTOM
}

/// Execution engine for an agent's interactive chat. See `Agent.runEngine`.
enum RunEngine {
  /// Forge owns the agent loop via OpenAI-compat chat completions.
  COMPLETIONS
  /// Delegate to the provider's structured agent-run API (Hermes /v1/runs).
  RUNS
}

enum AgentRuntimeMode {
  PERSISTENT
  EPHEMERAL
}

/// Where an agent runtime physically lives.
///   LOCAL_DAEMON — `forge daemon` running on a user's machine, polls
///                  Forge via SSE; no inbound webhook.
///   REMOTE_HTTP  — webhook receiver (today's Hermes-style integration).
///   CLOUD        — reserved for a future Forge-hosted runtime tier.
enum RuntimeKind {
  LOCAL_DAEMON
  REMOTE_HTTP
  CLOUD
}

enum RuntimeSelfTestStatus {
  PASSED
  FAILED
  UNSUPPORTED
}

/// Lifecycle of the AI triage suggestion attached to an issue at create
/// time. Null = AI was disabled or skipped (agent-authored, etc.).
enum AiTriageStatus {
  PENDING
  READY
  APPLIED
  DISMISSED
  ERROR
}

/// How the auto-dispatcher picks an agent for an unassigned queued issue.
enum AutoDispatchMode {
  MANUAL_ONLY
  ROUND_ROBIN
  PRIORITY_MATCH
  CAPABILITY_MATCH
}

/// The *intent* of a dispatched agent turn — what the agent is asked to do,
/// distinct from autoDispatchMode (which agent gets picked). EXECUTE = take it
/// to completion; RESEARCH = investigate + report, no mutations; REVIEW =
/// critique existing work; DISCUSS = answer in-thread, no work product.
/// See docs/agents/engagement-modes.md.
enum EngagementMode {
  EXECUTE
  RESEARCH
  REVIEW
  DISCUSS
}

/// How an AgentRun's `engagementMode` was decided at dispatch (added
/// 2026-06-23, Phase 2). Frozen on the run so the source tooltip shows
/// *why* a mode applies without re-resolving against later config drift.
/// Mirrors the `EngagementSource` TS union in `engagement-mode.ts` (the
/// kebab-case wire shape on event payloads maps to these at the single
/// persistence point). The first four mirror the pure resolver; the last
/// three are the inbox waterfall tiers that previously discarded their source.
enum EngagementSource {
  EXPLICIT
  SURFACE_DEFAULT
  POLICY_INFER
  POLICY_FIXED
  POLICY_REQUIRE_MARKER
  STICKY_ACTIVE_RUN
  AGENT_REQUEST
  PAYLOAD
}

/// How an @-mention with no explicit mode marker resolves. INFER = agent
/// infers intent and asks before anything irreversible (default). FIXED =
/// always use Workspace.mentionDefaultMode. REQUIRE_MARKER = no marker means
/// DISCUSS — execution requires an explicit marker.
enum MentionEngagementPolicy {
  INFER
  FIXED
  REQUIRE_MARKER
}

/// Classifies the intended use of an ApiKey. AGENT keys are tied to a
/// registered persistent agent (linkedAgentId is set, full scopes).
/// PERSONAL keys are user-owned with no agent link — read-only or scoped,
/// permanent until revoked. SESSION keys are short-lived (TTL via
/// expiresAt), narrow scope, and auto-purged.
enum ApiKeyKind {
  AGENT
  PERSONAL
  SESSION
}

/// Distinguishes a normal user/agent comment (BODY) from a single rolling
/// "live status" comment per AgentRun (STATUS). STATUS comments are
/// upserted via `comments.upsertStatus` and have a 1:1 link to the
/// owning AgentRun via `runId`. Body history is appended to `revisions`
/// so the conversation isn't lost when the agent updates its turn.
enum CommentKind {
  BODY
  STATUS
  /// Server-authored notice in the issue thread — assignment notes,
  /// auto-runtime tags, dispatch provenance, etc. SYSTEM rows have a
  /// null `authorId` and a null `authoringAgentId`; the renderer treats
  /// them as ambient narration (italic, muted, no avatar bubble). These
  /// rows are written directly inside the transaction that emits the
  /// triggering event (e.g. AGENT_ASSIGNED) without going through
  /// COMMENT_CREATED, so they don't re-fan-out / re-notify watchers.
  SYSTEM
}

/// Note variants. NOTE is the default scratchpad; JOURNAL is a daily
/// summary entry pinned to a calendar date. JOURNAL rows are unique per
/// (workspace, user, journalDate) so `notes.todayJournal` upserts cleanly.
enum NoteKind {
  NOTE
  JOURNAL
}

/// Lifecycle status for a Note. IDEA is the default capture state for
/// fresh thoughts; SOMEDAY parks them for later; ACTIVE means the note
/// has been promoted into work (either explicitly via `notes.promote` or
/// by the user moving it forward); ARCHIVED is the soft-delete tier
/// (orthogonal to `archivedAt`; archive UI uses the timestamp, status
/// drives chip + dashboard zone routing).
enum NoteStatus {
  IDEA
  SOMEDAY
  ACTIVE
  ARCHIVED
}

/// Discriminator for a WorkspaceCanvas. PROJECT/INITIATIVE/CYCLE/ISSUE
/// are anchored canvases (carry `scopeType` + `scopeId`). PERSONAL is
/// the per-user "Personal" canvas auto-provisioned for the dashboard.
/// DESIGN is the Figma-mode multi-page design surface (`activePageId`
/// tracks which top-level frame is the current page).
enum CanvasKind {
  PROJECT
  INITIATIVE
  CYCLE
  ISSUE
  PERSONAL
  DESIGN
}

/// Discriminator for a reusable CanvasStyle. COLOR captures fill /
/// stroke / text colors; TEXT captures font family / size / weight /
/// line-height presets; EFFECT captures shadow / blur / opacity.
enum CanvasStyleKind {
  COLOR
  TEXT
  EFFECT
}

/// Lifecycle of an AgentRun — opened on first activity from an agent
/// against an issue, closed when the issue transitions to a terminal
/// status, the agent reports completion, or the watchdog flags it
/// stalled. ABANDONED is the manual-cancel terminal state.
/// Lifecycle stage for an Artifact (durable specs, decisions, runbooks,
/// reports, briefs, verification logs). DRAFT is the working state;
/// IN_REVIEW signals a human/agent is reviewing; ACCEPTED is the
/// canonical published version; ARCHIVED is the soft-delete tombstone.
enum ArtifactStatus {
  DRAFT
  IN_REVIEW
  ACCEPTED
  ARCHIVED
}

/// Discriminator for Artifacts. DOCUMENT is the catch-all freeform
/// markdown; the rest are first-class document kinds so list/filter
/// surfaces can render purpose-specific icons + columns. Adding a
/// new kind: add the enum here, the migration, and the renderer
/// chip in `src/components/artifacts/artifact-type-chip.tsx`.
enum ArtifactType {
  DOCUMENT
  DECISION
  RUNBOOK
  REPORT
  SPEC
  BRIEF
  VERIFICATION
  /// Lightweight markdown sticky note. Surfaced by the Canvas
  /// `addNote` flow; lives in the standard Artifact table so it's
  /// searchable, attachable, and linkable like any other artifact.
  NOTE
}

enum AgentRunStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  STALLED
  /// Agent has self-blocked on the operator (or another agent) and is
  /// not progressing on its own. The stale watchdog
  /// (`agent-run-stale.ts`) intentionally skips WAITING runs so
  /// patient agents aren't misclassified as dead. Set via MCP
  /// `runs.setWaiting`; cleared via `runs.resumeWork` (back to ACTIVE)
  /// or terminal `runs.complete`. The Comment timeline + live pulse
  /// strip render WAITING in a soft ember tone (warning, not alarm).
  WAITING
}

// ----------------------------------------------------------------------------
// Auth (NextAuth v5)
// ----------------------------------------------------------------------------

model User {
  id                       String       @id @default(cuid())
  email                    String       @unique
  emailVerified            DateTime?
  name                     String?
  handle                   String?      @unique
  image                    String?
  /// IANA timezone, e.g. "America/New_York". Null = infer from browser.
  timezone                 String?
  /// BCP-47 locale, e.g. "en-US". Null = infer from browser.
  locale                   String?
  /// "12h" | "24h". Null = infer from locale.
  timeFormat               String?
  /// "light" | "dark" | "system". Null = "system".
  theme                    String?
  /// "compact" | "comfortable". Null = "compact" (default, current behavior).
  density                  String?
  /// "default" | "larger". Null = "default".
  textSize                 String?
  /// "full" | "reduced". Null = "full" (ambient motion on). "reduced"
  /// stamps `data-motion="off"` on <html>, freezing the forge-* motion
  /// layer to its static fallbacks (independent of OS reduced-motion).
  motion                   String?
  /// Ambient page background. "grid" (default) | "glow" | "dots" | "none".
  /// Stamps `data-bg` on <html>; the shell mounts one fixed background layer.
  backgroundStyle          String?
  /// Default Mission Control tab. One of MissionControlTab values
  /// ("live" | "queue" | "agents" | "history" | "chat"). Null = "live".
  /// When set, the overlay opens to this tab if no per-workspace
  /// state override exists yet.
  missionControlDefaultTab String?
  /// Default dashboard view — "list" or "canvas". Null = "list" (current
  /// Inbox behavior). Set when the user flips the dashboard view toggle.
  dashboardView            String?
  /// Workspace id remembered across logins; UI loads this one by default.
  lastWorkspaceId          String?
  /// Server-persisted onboarding state. Null = not dismissed; the
  /// localStorage flag (browser-scoped) controls the per-session
  /// resume-pill behavior. When set, the OnboardingCard is hidden
  /// permanently across devices.
  onboardingDismissedAt    DateTime?
  /// Steps the user has explicitly opted out of (currently only
  /// "member" / invite is skippable). Stored as string ids matching
  /// the OnboardingStep.id values.
  onboardingSkippedSteps   String[]     @default([])
  /// Last time the user opened the Inbox surface. Drives "new since
  /// last visit" badging in inbox buckets — issues whose `updatedAt`
  /// is greater than this timestamp count as unread for that user.
  /// Bumped via `inbox.visit` (debounced 5s server-side).
  lastInboxVisitAt         DateTime?
  /// When true, the time-tracker shows a "pomodoro complete" toast
  /// every `pomodoroMinutes` while a timer is running. Off by default.
  pomodoroEnabled          Boolean      @default(false)
  /// Length of one pomodoro work block (minutes). 25 is canonical.
  pomodoroMinutes          Int          @default(25)
  /// Length of the suggested break (minutes). Surfaced in the toast
  /// copy; the timer itself isn't paused — pomodoro is a prompt, not
  /// a hard stop.
  pomodoroBreakMinutes     Int          @default(5)
  /// Per-user dashboard layout customization. JSON shape:
  /// `{ order: string[], collapsed: string[], hidden: string[] }` keyed
  /// by widget id. Null = default layout (registry order, nothing
  /// collapsed or hidden).
  dashboardPrefs           Json?
  /// Last time the user viewed the What's New / changelog surface.
  /// Drives the "unseen entries" dot — when the latest changelog date
  /// is newer than this, the dot shows. Null = never seen.
  changelogSeenAt          DateTime?
  /// Instance-wide role. Default MEMBER; the bootstrap operator (matching
  /// `ADMIN_EMAIL`) is promoted to INSTANCE_ADMIN on sign-in and by the
  /// backfill script. Gates the /admin shell and global AgentProfile
  /// creation. See {@link InstanceRole}.
  instanceRole             InstanceRole @default(MEMBER)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  accounts               Account[]
  sessions               Session[]
  memberships            Membership[]
  agentProfiles          AgentProfile[]
  requestedAgentProfiles AgentProfile[]         @relation("AgentProfileRequester")
  connections            Connection[]
  externalResourceLinks  ExternalResourceLink[] @relation("ExternalResourceLinkCreator")

  authoredIssues                    Issue[]                  @relation("IssueAuthor")
  assignedIssues                    IssueAssignee[]
  comments                          Comment[]
  auditEntries                      AuditLog[]
  events                            ActivityEvent[]
  notificationStates                NotificationState[]
  pushSubscriptions                 PushSubscription[]
  createdProjects                   Project[]                @relation("ProjectCreator")
  apiKeys                           ApiKey[]
  claimedIssues                     Issue[]                  @relation("IssueClaimedBy")
  defaultIssueAssigneeForWorkspaces Workspace[]              @relation("WorkspaceDefaultIssueAssignee")
  recurringCreated                  RecurringIssue[]         @relation("RecurringCreator")
  savedViews                        SavedView[]
  issueSavedViews                   IssueSavedView[]
  timeEntries                       TimeEntry[]
  chatThreads                       ChatThread[]
  chatThreadReads                   ChatThreadRead[]
  runtimes                          Runtime[]
  controlRequestedRuns              AgentRun[]               @relation("AgentRunControlRequester")
  clearedAgentRuns                  AgentRun[]               @relation("AgentRunClearer")
  pins                              Pin[]
  recentItems                       RecentItem[]
  notes                             Note[]
  issueWatches                      IssueWatcher[]
  createdArtifacts                  Artifact[]               @relation("ArtifactCreator")
  artifactVersions                  ArtifactVersion[]        @relation("ArtifactVersionCreator")
  ownedContextSets                  ContextSet[]             @relation("ContextSetOwnerUser")
  createdExecutionPlans             ExecutionPlan[]          @relation("ExecutionPlanCreator")
  createdGoals                      Goal[]                   @relation("GoalCreator")
  executionSteps                    ExecutionStep[]          @relation("ExecutionStepUser")
  requestedReviewGates              ReviewGate[]             @relation("ReviewGateRequester")
  resolvedReviewGates               ReviewGate[]             @relation("ReviewGateResolver")
  requestedActionRequests           ActionRequest[]          @relation("ActionRequestRequester")
  assignedActionRequests            ActionRequest[]          @relation("ActionRequestAssignee")
  resolvedActionRequests            ActionRequest[]          @relation("ActionRequestResolver")
  actionRequestVotes                ActionRequestVote[]
  notificationPreferences           NotificationPreference[]
  createdCanvases                   WorkspaceCanvas[]        @relation("WorkspaceCanvasCreator")
  ownedCanvases                     WorkspaceCanvas[]        @relation("WorkspaceCanvasOwner")
  createdShapes                     CanvasShape[]            @relation("CanvasShapeCreator")
  createdCanvasFrames               CanvasFrame[]            @relation("CanvasFrameCreator")
  createdCanvasGroups               CanvasGroup[]            @relation("CanvasGroupCreator")
  createdCanvasComponents           CanvasComponent[]        @relation("CanvasComponentCreator")
  createdCanvasStyles               CanvasStyle[]            @relation("CanvasStyleCreator")

  @@index([handle])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Instance-global sign-in provider, configured from the admin UI rather
/// than env vars. Auth is per *user* (not per workspace), so these rows are
/// not tenant-scoped. The provider list is read at request time by the
/// NextAuth lazy config (`buildAuthProviders`), so enable/disable/add takes
/// effect without a redeploy (subject to a short read cache).
///
/// `clientSecret` is encrypted at rest by the app layer (AES-256-GCM, key
/// derived from AUTH_SECRET — see `src/server/crypto.ts`); it is never
/// returned to the client.
model SsoProvider {
  id           String   @id @default(cuid())
  /// Doubles as the NextAuth provider id, so the OAuth callback URL is
  /// `/api/auth/callback/<id>`. Stable for the row's lifetime.
  type         SsoType
  /// Display name + button label, e.g. "Authelia", "Company SSO".
  name         String
  enabled      Boolean  @default(false)
  /// OIDC issuer base URL (discovery via `<issuer>/.well-known/
  /// openid-configuration`). Required for OIDC, null for GitHub/Google.
  issuer       String?
  clientId     String
  /// Encrypted (`iv:tag:ciphertext`, base64). Decrypted only server-side.
  clientSecret String
  /// Space-separated OAuth scopes; defaults applied per type when null.
  scopes       String?
  /// Maps to NextAuth `allowDangerousEmailAccountLinking`. Off by default —
  /// only enable when you trust the IdP to assert verified emails.
  allowLinking Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Tenancy
// ----------------------------------------------------------------------------

model Workspace {
  id                            String                   @id @default(cuid())
  slug                          String                   @unique
  name                          String
  /// Short key used for issue identifiers: e.g. `FRG-123`.
  key                           String                   @unique
  avatarUrl                     String?
  /// Default cycle length (days). Overridable per cycle at create time.
  cycleLengthDays               Int                      @default(7)
  /// Default rest/cooldown days between cycles (0 = back-to-back).
  cycleCooldownDays             Int                      @default(0)
  /// When true, the time-tracking surface is enabled for this workspace.
  timeTrackingEnabled           Boolean                  @default(false)
  /// Soft cap on total attachment storage (MB) for this workspace.
  attachmentQuotaMb             Int                      @default(1024)
  /// How Forge fills human assignees on issue create when no explicit
  /// assignees were supplied.
  defaultIssueAssigneeMode      DefaultIssueAssigneeMode @default(NONE)
  /// Member used when `defaultIssueAssigneeMode = USER`. Validated by
  /// settings writes and ignored on create if the membership later goes stale.
  defaultIssueAssigneeUserId    String?
  /// Master toggle for auto-dispatching queued issues to agents.
  autoDispatch                  Boolean                  @default(false)
  /// Strategy used when autoDispatch is on. MANUAL_ONLY disables picking.
  autoDispatchMode              AutoDispatchMode         @default(MANUAL_ONLY)
  /// Default engagement mode for work dispatched via assignment / queue
  /// (the "you're handing it over" surface). See docs/agents/engagement-modes.md.
  assignmentEngagementMode      EngagementMode           @default(EXECUTE)
  /// How an @-mention with no explicit mode marker resolves.
  mentionEngagementPolicy       MentionEngagementPolicy  @default(INFER)
  /// Fallback mode for @-mentions under FIXED policy (or when INFER yields
  /// nothing actionable). Mentions are conversational by default.
  mentionDefaultMode            EngagementMode           @default(DISCUSS)
  /// When true, assigning (manually or auto) immediately pushes the agent
  /// webhook to start work; when false, the issue sits in the agent queue.
  autoStartOnAssign             Boolean                  @default(false)
  /// Heartbeat idle timeout: a heartbeat-tracked agent (Hermes, local daemon,
  /// or a health-probed app server) flips to OFFLINE once its last heartbeat
  /// is older than this window (see `sweepIdleAgents`). 0 = disabled (the
  /// agent never auto-offlines). Default 15 so true presence works out of the
  /// box — well above the 60s heartbeat/probe cadence.
  agentIdleTimeoutMinutes       Int                      @default(15)
  /// Gated dispatch — assignment lands in queue but agent does not start
  /// work until a human approves.
  requireApprovalBeforeStart    Boolean                  @default(false)
  /// When > 0, agents must move issues out of BACKLOG/TODO within
  /// this many minutes of assignment. Stale issues emit ISSUE_STALLED
  /// and (depending on `autoRedispatchOnStall`) get their assignedAgentId
  /// cleared so the next auto-dispatch picks them up.
  assignmentSlaMinutes          Int                      @default(0)
  /// When true, ISSUE_STALLED also clears assignedAgentId so the
  /// auto-dispatcher re-picks. When false, the event fires but the
  /// assignment is preserved (operator-driven workflow).
  autoRedispatchOnStall         Boolean                  @default(false)
  /// When > 0, every successful AGENT_ASSIGNED delivery starts an
  /// "ack window" — the agent must comment on or transition the
  /// issue within this many seconds, otherwise an AGENT_NOACK event
  /// fires (and the issue is re-dispatched if `autoRedispatchOnNoack`
  /// is true). 0 disables the check. 60–180s is reasonable when the
  /// agent's loop is fast.
  requiredAckSeconds            Int                      @default(0)
  /// When true, AGENT_NOACK also clears assignedAgentId so the
  /// auto-dispatcher re-picks. Mirrors `autoRedispatchOnStall`.
  autoRedispatchOnNoack         Boolean                  @default(false)
  /// When true, the maintenance worker scans for SLA breaches every
  /// minute and emits ISSUE_SLA_BREACH events. Off by default —
  /// requires `Issue.slaMinutes` to be set per-issue, otherwise the
  /// sweep is a no-op for the row.
  slaEnforcementEnabled         Boolean                  @default(false)
  /// Master toggle for AI features in this workspace. Off by default.
  /// Gates AI triage on issue create AND Coach agent comments on
  /// stall/noack/breach events. Requires `ANTHROPIC_API_KEY` in env.
  aiEnabled                     Boolean                  @default(false)
  /// When true, every newly created issue (by a human author) kicks off
  /// a background AI triage. Null when `aiEnabled` is off.
  aiTriageOnCreate              Boolean                  @default(true)
  /// When true, Coach agents post diagnostic comments on
  /// ISSUE_STALLED / AGENT_NOACK / ISSUE_SLA_BREACH events. The
  /// workspace must have an Agent with role=COACH for this to fire.
  aiCoachEnabled                Boolean                  @default(true)
  /// Which provider Forge talks to for AI features. Default `hermes`
  /// uses Mission-Control's pattern: an OpenAI-compatible Hermes
  /// gateway that itself fans out to Anthropic / OpenAI / etc. via the
  /// model-router plugin. Other values (`openai`, `anthropic`,
  /// `custom`) bypass Hermes and call the named provider directly.
  /// All provider URLs / keys live in env — see ai-providers.ts.
  aiProvider                    String                   @default("hermes")
  /// Optional model override. The provider supplies a sensible default
  /// (Hermes default = workspace's session model; OpenAI default =
  /// gpt-4o-mini; Anthropic default = claude-haiku-4-5-20251001).
  aiModel                       String?
  /// AgentRun monitoring: when > 0, the watchdog flags an ACTIVE run
  /// as STALLED if it sees no AgentRunEvent within this many minutes.
  /// Defaults to 30 — long enough not to misclassify a quiet-but-working
  /// agent (they emit run events / status comments as they work), short
  /// enough that a finished turn an agent didn't close via `runs.complete`
  /// stops lingering as a live run on the issue page. 0 disables the sweep.
  agentRunStaleMinutes          Int                      @default(30)
  /// Auto-archive idle EPHEMERAL agents after this many minutes with no
  /// heartbeat (a session CLI that vanished). 0 = disabled (default). Only
  /// EPHEMERAL agents are touched; PERSISTENT agents (Hermes, etc.) are never
  /// reaped by this sweep. Archive is reversible (unarchive / re-bind), so
  /// this just keeps abandoned session rows out of the lists.
  ephemeralAgentIdleMinutes     Int                      @default(0)
  /// Per-run safety budgets (added 2026-06-23). Opt-in: null = no cap.
  /// A run that exceeds any set cap triggers `runBudgetAction` (default
  /// PAUSE → stop the provider + park WAITING + notify). Distinct from
  /// `agentRunStaleMinutes`, which is *idle*-based — these catch a
  /// busy-but-runaway loop (the AXI-75 run burned 21.1M tokens because
  /// nothing capped it). Cumulative tokensIn+tokensOut for the run.
  runTokenBudget                Int?
  /// Per-run USD cost cap. Null = no cap. Matched against `costUsd`.
  runCostBudgetUsd              Decimal?                 @db.Decimal(10, 4)
  /// Per-run wall-clock cap (minutes since `startedAt`). Null = no cap.
  runMaxMinutes                 Int?
  /// Emit a one-time AGENT_RUN_BUDGET_WARNING when a run crosses this
  /// percentage of any set budget (default 80). 0 disables the warning.
  runBudgetWarnPct              Int                      @default(80)
  /// What to do on breach. PAUSE (default) parks the run WAITING and
  /// raises an actionable "raise budget & resume / abandon" request;
  /// STOP closes it ABANDONED. Either way the provider run is stopped.
  runBudgetAction               RunBudgetAction          @default(PAUSE)
  /// Optional Status row id to auto-transition into on AGENT_ASSIGNED.
  /// When set, the audit/event fan-out promotes assigned issues to this
  /// status (must be in IN_PROGRESS category, validated at write time).
  /// Skipped if the issue is already in IN_PROGRESS / IN_REVIEW or in a
  /// terminal category (DONE / CANCELED). Null disables — agents must
  /// transition client-side via statuses.list + issues.transition.
  startedStatusId               String?
  /// Optional Status row id to auto-transition into when an EXECUTE run
  /// completes successfully via `runs.complete` (must be in IN_REVIEW
  /// category, validated at write time). An agent finishing EXECUTE work
  /// is a "ready for human review" signal, not a "mark done" signal —
  /// Done stays a human (or explicitly-instructed) action. Skipped if the
  /// issue is already IN_REVIEW or in a terminal category (DONE /
  /// CANCELED); NOT skipped for BACKLOG/TODO/IN_PROGRESS since completing
  /// work should surface for review regardless of prior state. Null
  /// disables — no auto-transition on completion.
  reviewStatusId                String?
  /// Issues with `updatedAt` older than this threshold (in days) are
  /// considered "stalled" by the dashboard suggestions bucket. Settings-
  /// driven so admins can tune the workspace's idle definition without
  /// editing handler code. 0 disables the bucket.
  stalledThresholdDays          Int                      @default(7)
  /// Minutes since `Agent.lastHeartbeatAt` after which a PERSISTENT
  /// agent's presence row surfaces a warning chip on the agents page.
  /// EPHEMERAL agents only heartbeat while running, so the warning is
  /// suppressed for them. 0 disables the warning entirely.
  agentHeartbeatWarnMinutes     Int                      @default(5)
  /// Minutes since `Agent.lastHeartbeatAt` after which a PERSISTENT
  /// agent's presence row escalates to the critical (danger) tier.
  /// Should be > `agentHeartbeatWarnMinutes`. 0 disables critical.
  agentHeartbeatCriticalMinutes Int                      @default(30)
  /// Master toggle for the `/api/ingest/email` inbound endpoint. When
  /// off, the endpoint returns 403 even if the HMAC signature is valid.
  /// Off by default; admins flip it on in `/settings/integrations`.
  emailIngestEnabled            Boolean                  @default(false)
  /// HMAC-SHA256 shared secret for the email-ingest endpoint. Caller
  /// signs the JSON body and sends it as `x-forge-email-signature`.
  /// Null until the admin generates one; rotating it invalidates any
  /// outstanding inbound integrations.
  emailIngestSecret             String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  deletedAt                     DateTime?

  defaultIssueAssigneeUser User? @relation("WorkspaceDefaultIssueAssignee", fields: [defaultIssueAssigneeUserId], references: [id], onDelete: SetNull)

  memberships             Membership[]
  projects                Project[]
  issues                  Issue[]
  statuses                Status[]
  labels                  Label[]
  comments                Comment[]
  attachments             Attachment[]
  auditLogs               AuditLog[]
  events                  ActivityEvent[]
  notificationStates      NotificationState[]
  plugins                 Plugin[]
  apiKeys                 ApiKey[]
  webhooks                Webhook[]
  metrics                 MetricAggregate[]
  skills                  Skill[]
  templates               IssueTemplate[]
  projectTemplates        ProjectTemplate[]
  recurring               RecurringIssue[]
  savedViews              SavedView[]
  issueSavedViews         IssueSavedView[]
  cycles                  Cycle[]
  initiatives             Initiative[]
  issueRelations          IssueRelation[]
  timeEntries             TimeEntry[]
  agents                  Agent[]
  dispatchRules           DispatchRule[]
  agentRuns               AgentRun[]
  agentRunEvents          AgentRunEvent[]
  chatThreads             ChatThread[]
  chatThreadReads         ChatThreadRead[]
  chatMessages            ChatMessage[]
  runtimes                Runtime[]
  githubApps              GithubApp[]
  providerCredentials     ProviderCredential[]
  connectionMappings      ConnectionMapping[]
  externalResources       ExternalResource[]
  externalResourceLinks   ExternalResourceLink[]
  externalWebhookEvents   ExternalWebhookEvent[]
  pins                    Pin[]
  recentItems             RecentItem[]
  notes                   Note[]
  issueWatchers           IssueWatcher[]
  artifacts               Artifact[]
  artifactVersions        ArtifactVersion[]
  contextSets             ContextSet[]
  contextSetItems         ContextSetItem[]
  executionPlans          ExecutionPlan[]
  goals                   Goal[]
  executionSteps          ExecutionStep[]
  agentCrews              AgentCrew[]
  agentCrewMembers        AgentCrewMember[]
  reviewGates             ReviewGate[]
  actionRequests          ActionRequest[]
  notificationPreferences NotificationPreference[]
  canvases                WorkspaceCanvas[]
  canvasNodes             WorkspaceCanvasNode[]
  canvasEdges             WorkspaceCanvasEdge[]
  canvasShapes            CanvasShape[]
  canvasFrames            CanvasFrame[]
  canvasGroups            CanvasGroup[]
  canvasComponents        CanvasComponent[]
  canvasInstances         CanvasComponentInstance[]
  canvasStyles            CanvasStyle[]
  startedStatus           Status?                   @relation("WorkspaceStartedStatus", fields: [startedStatusId], references: [id], onDelete: SetNull)
  reviewStatus            Status?                   @relation("WorkspaceReviewStatus", fields: [reviewStatusId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([defaultIssueAssigneeUserId])
}

model Membership {
  id                       String   @id @default(cuid())
  userId                   String
  workspaceId              String
  role                     Role     @default(MEMBER)
  /// Per-workspace override for Mission Control's default tab. Empty
  /// (null) falls back to `User.missionControlDefaultTab`, then to
  /// "live". Lets an operator say "Chat is my default in Workspace A,
  /// Live is my default in Workspace B" without juggling global prefs.
  missionControlDefaultTab String?
  createdAt                DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

// ----------------------------------------------------------------------------
// Work items
// ----------------------------------------------------------------------------

model Project {
  id           String    @id @default(cuid())
  workspaceId  String
  key          String
  name         String
  description  String?   @db.Text
  icon         String?
  color        String?
  archived     Boolean   @default(false)
  startDate    DateTime?
  targetDate   DateTime?
  /// Optional parent initiative that groups related projects.
  initiativeId String?
  createdById  String
  /// Backlink for a project created via `notes.promote`. Mirrors
  /// `Issue.sourceNoteId`.
  sourceNoteId String?
  /// Git repository this project's work lives in. When set, a runtime
  /// provisions (clone-or-pulls) it so an agent dispatched to one of this
  /// project's issues lands in the right checkout — letting one runtime serve
  /// many codebases. `repoUrl` is an https (token/app-auth) or ssh remote;
  /// `repoBranch` null = the remote's default branch. The clone path is
  /// derived from the repo name. Auth comes from the runtime's GitHub App or
  /// secrets (see `docs/agents/runtime-credentials.md`).
  repoUrl      String?
  repoBranch   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("ProjectCreator", fields: [createdById], references: [id])
  initiative     Initiative?      @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  issues         Issue[]
  templates      IssueTemplate[]
  recurring      RecurringIssue[]
  dispatchRules  DispatchRule[]
  artifacts      Artifact[]
  executionPlans ExecutionPlan[]

  @@unique([workspaceId, key])
  @@index([workspaceId, archived])
  @@index([initiativeId])
}

/// Workspace-scoped status; categories map to StatusCategory enum.
model Status {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  category    StatusCategory
  color       String
  position    Int
  isDefault   Boolean        @default(false)

  workspace           Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues              Issue[]
  workspaceStartedFor Workspace[] @relation("WorkspaceStartedStatus")
  workspaceReviewFor  Workspace[] @relation("WorkspaceReviewStatus")

  @@unique([workspaceId, name])
  @@index([workspaceId, category])
}

model Label {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues        IssueLabel[]
  dispatchRules DispatchRule[]

  @@unique([workspaceId, name])
}

model Issue {
  id                    String          @id @default(cuid())
  workspaceId           String
  projectId             String?
  parentId              String?
  /// Optional cycle membership. SetNull on cycle delete so issues survive.
  cycleId               String?
  /// Human-readable identifier: `${workspace.key}-${number}` e.g. `FRG-42`.
  number                Int
  kind                  WorkItemKind    @default(ISSUE)
  title                 String
  description           String?         @db.Text
  statusId              String
  priority              Priority        @default(NONE)
  authorId              String
  dueDate               DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  canceledAt            DateTime?
  estimate              Float?
  /// SLA target, in minutes from creation. Used for breach detection.
  slaMinutes            Int?
  /// AI triage state machine. Null = not run. Set to PENDING when the
  /// background triage call is fired, READY when a suggestion is
  /// available, APPLIED/DISMISSED after the operator acts, ERROR if
  /// the call failed. Lets the UI render the chip without a separate
  /// table.
  aiTriageStatus        AiTriageStatus?
  aiSuggestedPriority   Priority?
  aiSuggestedLabelIds   String[]        @default([])
  aiSuggestedAgentId    String?
  aiTriageReasoning     String?         @db.Text
  aiTriagedAt           DateTime?
  aiTriageDecidedAt     DateTime?
  /// Agent queue — true means eligible for `issues.claim` via MCP.
  queued                Boolean         @default(false)
  claimedAt             DateTime?
  claimedById           String?
  /// When an agent (not a human) holds the claim, the agent that claimed it —
  /// set from the api key's `linkedAgentId` on `issues.claim`. Independent of
  /// `claimedById` (the api-key owner user); null for human claims. Lets the
  /// UI attribute a claim to the agent rather than its owner account.
  claimedByAgentId      String?
  claimExpiresAt        DateTime?
  /// Explicit agent assignment. Independent of `claimedById` (human claim).
  /// Set by users or the auto-dispatcher; cleared on unassign.
  assignedAgentId       String?
  /// User-set "on hold" timestamp. When non-null AND in the future, the
  /// issue is hidden from inbox / stalled buckets — operators have asked
  /// the system to stop nagging them about it until then. Cleared via
  /// `issue.unsnooze`. Auto-clears on read in consumers (no background
  /// sweep — comparison is `snoozedUntil > now()` everywhere).
  snoozedUntil          DateTime?
  /// Opaque blob recording the most recent dispatcher decision for this
  /// issue, mirroring what's emitted on the AGENT_ASSIGNED payload but
  /// pinned to the row for cheap "why was X picked" attribution. Shape:
  /// { mode, candidatesConsidered: string[], picked: string,
  ///   reasonText: string, decidedAt: DateTime }. See
  /// `src/server/services/dispatcher.ts` for the producer.
  dispatchReason        Json?
  /// Agentic work OS — issue-level completion contract.
  /// Markdown describing what "done" looks like for an agent acting on
  /// this issue. Surfaced in the dispatch context bundle and in the
  /// issue detail panel so operators and agents can agree before work
  /// starts. Null = no explicit contract (legacy issues).
  expectedOutput        String?         @db.Text
  /// Structured verification checklist. Shape: array of
  /// `{ id?: string, label: string, kind?: "manual"|"command"|"artifact",
  ///   value?: string, done?: boolean }`. The agent reports completion
  /// against this list in its final response; auto-mark via runner is a
  /// future cleanup.
  verificationChecklist Json?
  /// When true, the agent's completion submission must include at least
  /// one Artifact link (any kind). False (default) = optional.
  artifactRequired      Boolean         @default(false)
  /// Backlink for an issue created via `notes.promote` — points at the
  /// source Note row so the UI can render "promoted from note …"
  /// provenance and the user can navigate back. SetNull on Note delete
  /// preserves the issue.
  sourceNoteId          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent         Issue?                 @relation("IssueChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       Issue[]                @relation("IssueChildren")
  cycle          Cycle?                 @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  status         Status                 @relation(fields: [statusId], references: [id])
  author         User                   @relation("IssueAuthor", fields: [authorId], references: [id])
  claimedBy      User?                  @relation("IssueClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedByAgent Agent?                 @relation("IssueClaimedByAgent", fields: [claimedByAgentId], references: [id], onDelete: SetNull)
  assignedAgent  Agent?                 @relation("IssueAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignees      IssueAssignee[]
  labels         IssueLabel[]
  comments       Comment[]
  attachments    Attachment[]
  relationsFrom  IssueRelation[]        @relation("IssueRelationFrom")
  relationsTo    IssueRelation[]        @relation("IssueRelationTo")
  timeEntries    TimeEntry[]
  agentRuns      AgentRun[]
  watchers       IssueWatcher[]
  artifacts      Artifact[]
  executionPlans ExecutionPlan[]
  executionSteps ExecutionStep[]        @relation("ExecutionStepIssue")
  goals          Goal[]
  actionRequests ActionRequest[]
  externalLinks  ExternalResourceLink[]

  @@unique([workspaceId, number])
  @@index([workspaceId, statusId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, priority])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, queued, claimedAt])
  @@index([workspaceId, cycleId])
  @@index([workspaceId, assignedAgentId])
  @@index([workspaceId, aiTriageStatus])
  @@index([snoozedUntil])
}

/// Reusable project blueprints shown in the "Starter templates" picker.
model ProjectTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  /// Suggested project key. Can be overridden at create time.
  suggestedKey String
  description  String?  @db.Text
  color        String?
  icon         String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Reusable issue starting-points scoped to a workspace (or project).
model IssueTemplate {
  id                  String   @id @default(cuid())
  workspaceId         String
  projectId           String?
  name                String
  titleTemplate       String
  descriptionTemplate String?  @db.Text
  defaultPriority     Priority @default(NONE)
  /// Convenience: comma-free list of label IDs to apply. Validated server-side.
  labelIds            String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Scheduled issue that the in-process ticker auto-creates on each `intervalDays`.
model RecurringIssue {
  id                  String    @id @default(cuid())
  workspaceId         String
  projectId           String?
  name                String
  titleTemplate       String
  descriptionTemplate String?   @db.Text
  defaultPriority     Priority  @default(NONE)
  intervalDays        Int
  nextRunAt           DateTime
  lastRunAt           DateTime?
  active              Boolean   @default(true)
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User      @relation("RecurringCreator", fields: [createdById], references: [id])

  @@index([nextRunAt, active])
  @@index([workspaceId])
}

/// Bookmarked filter preset. userId null = shared workspace view.
model SavedView {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  name        String
  /// Payload: {projectId?, statusId?, assigneeId?, priority?, query?, view: "list"|"board"}
  filters     Json
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
}

/// Per-user issue saved view — distinct from the (legacy) SavedView model
/// which mixes workspace-shared and user-private rows. Each row here is
/// always owned by exactly one user; ordering is explicit via
/// `orderIndex` so the UI can drag-reorder. The `filters` payload shape
/// is opaque at the schema layer (a Phase 1 D-agent owns the zod for it)
/// so future filter primitives don't require a migration.
model IssueSavedView {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  /// Opaque filter blob. Shape lives client-side / in zod; the server
  /// just round-trips it. See Phase 1 for the canonical schema.
  filters     Json
  /// Optional sort key the consuming list applies. Null = list default.
  sortKey     String?
  /// Lower = earlier in the saved-views list. Stable across mutates.
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, name])
  @@index([workspaceId, userId])
  @@index([userId, orderIndex])
}

model IssueAssignee {
  issueId   String
  userId    String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

// ----------------------------------------------------------------------------
// Social / content
// ----------------------------------------------------------------------------

model Comment {
  id               String           @id @default(cuid())
  workspaceId      String
  /// Nullable since migration 0040 — a Comment hangs off EITHER an
  /// issue or an execution step, never both. The router layer keeps
  /// the "exactly one of {issueId, executionStepId}" invariant
  /// (comment.create requires issueId; executionPlan.stepCommentCreate
  /// requires executionStepId).
  issueId          String?
  /// New in migration 0040 — owning ExecutionStep for inline plan-step
  /// threads. CASCADE on step delete so threads vanish with the step.
  executionStepId  String?
  /// Author user id. Nullable since migration 0047 to support SYSTEM-kind
  /// comments (assignment notices, dispatch provenance) that have no
  /// human author. BODY/STATUS rows still always carry an authorId
  /// in practice — enforced by the application layer, not the schema.
  authorId         String?
  /// When the comment was created via an API key whose `linkedAgentId`
  /// pointed at an Agent, we record that Agent here so the UI can
  /// render it as "Victor (agent)" rather than the human key owner.
  /// Null for human-session comments. SetNull on agent delete so the
  /// comment survives agent lifecycle churn.
  authoringAgentId String?
  body             String           @db.Text
  /// BODY = normal comment (default). STATUS = the single rolling live
  /// status comment for an AgentRun, upserted via `comments.upsertStatus`.
  kind             CommentKind      @default(BODY)
  /// 1:1 link to the owning AgentRun for STATUS-kind comments. Always
  /// null for BODY comments. Postgres treats NULL as distinct in unique
  /// indexes, so many BODYs can coexist while each AgentRun has at most
  /// one STATUS row.
  runId            String?          @unique
  /// Compact step label rendered next to the live pulse (e.g. "running
  /// tests"). Null for BODY comments.
  currentStep      String?
  /// Append-only revision history. Two flavors share this column,
  /// discriminated by `kind`:
  ///   STATUS comments (agent rolling status) → `[{ body, currentStep, ts }]`
  ///   BODY comments (regular thread comments edited via
  ///     `comment.update`) → `[{ body, editedAt }]`
  /// Server-side caps the array length to keep growth bounded
  /// (STATUS = 50 entries, BODY = 20 entries — oldest dropped first).
  /// Defaults to `[]` so consumers can read length without null
  /// guards. Migration 0050 backfilled existing NULL rows to `[]`.
  revisions        Json             @default("[]")
  /// Optional bag of short quick-reply chips an agent attached to the
  /// comment (added 2026-05-20, migration 0048). The thread renders
  /// these as clickable pills below the comment body when the comment
  /// is agent-authored AND it's the most recent BODY comment in the
  /// thread (so old chips don't linger). Capped to 4 strings, each
  /// ≤80 chars by the create handler. Defaults to an empty array so
  /// existing rows don't need a backfill.
  suggestedReplies String[]         @default([])
  /// Optional agent confidence flag (added 2026-05-20, migration 0050).
  /// Only meaningful for agent-authored comments; the UI hides the
  /// chip on human-authored rows. LOW = tentative, HIGH = verified.
  /// Null = no signal attached (default).
  confidence       ConfidenceLevel?
  /// Mirror of Comment.updatedAt at the time of the most recent body
  /// edit, set by `comment.update` (added 2026-05-20, migration 0050).
  /// Distinct from `updatedAt` (which Prisma bumps on every column
  /// change, including suggestedReplies / confidence). Null = body
  /// has never been edited.
  editedAt         DateTime?
  /// Structured agent requests attached to this comment (added 2026-06-16,
  /// migration 0084). Each entry carries targetAgentId, mode, and optional
  /// assignIssue flag so the composer and timeline can render first-class
  /// run-mode chips without parsing raw markdown.
  agentRequests    Json             @default("[]")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue          Issue?         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  executionStep  ExecutionStep? @relation("ExecutionStepComments", fields: [executionStepId], references: [id], onDelete: Cascade)
  author         User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authoringAgent Agent?         @relation("AgentAuthoredComments", fields: [authoringAgentId], references: [id], onDelete: SetNull)
  run            AgentRun?      @relation("AgentRunStatusComment", fields: [runId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@index([workspaceId, createdAt])
  @@index([authoringAgentId])
  @@index([issueId, kind])
  @@index([executionStepId, createdAt])
}

/// Polymorphic attachment: `targetType` is one of "issue" | "initiative" |
/// "cycle" | "comment"; `targetId` references the owning row.
/// `issueId` is preserved as a nullable FK for backward compatibility while
/// new code migrates to the targetType/targetId pair.
///
/// `kind` distinguishes uploaded bytes (FILE — backed by an object in
/// MinIO via `url`) from external links (LINK — `externalUrl` points
/// at a Google Doc / GitHub PR / arbitrary web resource; no MinIO
/// object). For LINK rows the `filename` / `mimeType` / `size` / `url`
/// fields are still populated (filename = linkTitle ?? hostname,
/// mimeType = "text/url", size = 0, url = externalUrl) so existing
/// callers that only select those columns keep working without churn.
model Attachment {
  id          String         @id @default(cuid())
  workspaceId String
  issueId     String?
  targetType  String?
  targetId    String?
  kind        AttachmentKind @default(FILE)
  filename    String
  mimeType    String
  size        Int
  url         String
  /// Set when `kind = LINK` — the canonical external URL the agent /
  /// user attached. Null for FILE rows.
  externalUrl String?
  /// Optional human-readable label for LINK rows. Defaults to the URL
  /// hostname when the caller doesn't supply one. Null for FILE rows.
  linkTitle   String?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([workspaceId, targetType, targetId])
}

/// Distinguishes uploaded byte attachments (FILE) from external-link
/// attachments (LINK) on the polymorphic `Attachment` model.
enum AttachmentKind {
  FILE
  LINK
}

// ----------------------------------------------------------------------------
// Audit + analytics
// ----------------------------------------------------------------------------

/// Immutable audit log — row-level change tracking for compliance.
model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String
  actorId      String?
  /// When the action came through an agent-linked API key, the Agent
  /// is the recorded actor; `actorId` remains the human key-owner as
  /// secondary metadata. Null for human-driven actions.
  actorAgentId String?
  entity       String
  entityId     String
  action       String
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorAgent Agent?    @relation("AuditLogActorAgent", fields: [actorAgentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, entity, entityId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, actorAgentId])
}

/// Business-facing event stream. Plugins subscribe to these.
/// Separate from AuditLog — audit is for compliance, events for product.
model ActivityEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  kind         EventKind
  actorId      String?
  /// When the action came through an agent-linked API key, the Agent
  /// is the recorded actor; `actorId` remains the human key-owner as
  /// secondary metadata. Null for human-driven / system actions.
  actorAgentId String?
  /// Primary subject reference, e.g. issueId.
  subjectType  String
  subjectId    String
  payload      Json
  createdAt    DateTime  @default(now())

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor              User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorAgent         Agent?              @relation("ActivityEventActorAgent", fields: [actorAgentId], references: [id], onDelete: SetNull)
  deliveries         WebhookDelivery[]
  notificationStates NotificationState[]

  @@index([workspaceId, kind, createdAt])
  @@index([workspaceId, subjectType, subjectId])
  @@index([workspaceId, actorAgentId, createdAt])
}

/// Mutable per-user alert lifecycle layered on immutable ActivityEvent rows.
model NotificationState {
  id                String               @id @default(cuid())
  workspaceId       String
  userId            String
  eventId           String
  replacementKey    String?
  severity          NotificationSeverity @default(INFO)
  importance        Int                  @default(0)
  status            NotificationStatus   @default(UNREAD)
  persistent        Boolean              @default(true)
  primaryHref       String?
  detailHref        String?
  summary           String
  reason            String?              @db.Text
  recommendedAction String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  readAt            DateTime?
  dismissedAt       DateTime?
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, eventId])
  @@index([workspaceId, userId, status, importance, createdAt])
  @@index([workspaceId, userId, replacementKey])
  @@index([eventId])
}

/// Browser Web Push subscription for one signed-in user/device.
/// Endpoint is globally unique per browser subscription. Revoked rows
/// are retained briefly for diagnostics and overwritten if the browser
/// reuses the same endpoint.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique @db.Text
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([revokedAt, updatedAt])
}

/// Denormalized metric rollups computed by scheduled jobs.
/// Granularity: day | week | month. Dimensions stored as JSON for flexibility.
model MetricAggregate {
  id          String   @id @default(cuid())
  workspaceId String
  metric      String
  granularity String
  bucket      DateTime
  dimensions  Json
  value       Float
  computedAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, granularity, bucket, dimensions])
  @@index([workspaceId, metric, bucket])
}

// ----------------------------------------------------------------------------
// Plugins + agents (MCP / Skills)
// ----------------------------------------------------------------------------

model Plugin {
  id          String        @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  description String?       @db.Text
  version     String
  /// Manifest as JSON (validated against PluginManifest zod schema).
  manifest    Json
  scopes      PluginScope[]
  status      PluginStatus  @default(PENDING)
  /// Outbound HTTP endpoint for webhook delivery (optional).
  webhookUrl  String?
  /// Shared secret for HMAC signing (stored encrypted in column by app layer).
  secret      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skills    Skill[]
  apiKeys   ApiKey[]
  webhooks  Webhook[]

  @@unique([workspaceId, slug])
  @@index([status])
}

model Skill {
  id           String   @id @default(cuid())
  workspaceId  String
  pluginId     String
  name         String
  description  String?  @db.Text
  /// JSON Schema for invocation input.
  inputSchema  Json
  /// JSON Schema for invocation output.
  outputSchema Json?
  /// Where this skill executes: "plugin" (delegated via webhook) or "local" (server-side handler).
  runtime      String
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plugin    Plugin    @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, name])
  @@index([workspaceId])
}

model ApiKey {
  id            String        @id @default(cuid())
  workspaceId   String
  /// Either userId (personal key) OR pluginId (plugin key) must be set.
  userId        String?
  pluginId      String?
  name          String
  /// SHA-256 of the raw key. Raw key shown once at creation.
  hashedKey     String        @unique
  prefix        String
  /// Classifies the intended use of this key (AGENT / PERSONAL / SESSION).
  /// Default AGENT keeps backfill-safe for existing rows via migration.
  kind          ApiKeyKind    @default(AGENT)
  scopes        PluginScope[]
  /// Optional narrowing: restrict this key to specific project ids.
  /// Empty array = no restriction.
  projectIds    String[]      @default([])
  /// Optional narrowing: restrict this key to specific label ids.
  labelIds      String[]      @default([])
  /// Optional narrowing: restrict this key to specific initiative ids.
  initiativeIds String[]      @default([])
  /// When set, this key acts as a specific agent. MCP tools like
  /// `issues.assigned` infer the agent from the key; webhook payloads can
  /// reverse-route by agent without a separate lookup.
  linkedAgentId String?
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime      @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plugin      Plugin?   @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  linkedAgent Agent?    @relation("AgentApiKeys", fields: [linkedAgentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([prefix])
  @@index([linkedAgentId])
}

model Webhook {
  id          String      @id @default(cuid())
  workspaceId String
  pluginId    String?
  url         String
  secret      String
  events      EventKind[]
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plugin     Plugin?           @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId, active])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  webhookId      String
  eventId        String
  status         WebhookDeliveryStatus @default(PENDING)
  attempt        Int                   @default(0)
  responseStatus Int?
  responseBody   String?               @db.Text
  scheduledAt    DateTime              @default(now())
  deliveredAt    DateTime?

  webhook Webhook       @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event   ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([webhookId])
}

// ----------------------------------------------------------------------------
// Cycles / initiatives / relations / time
// ----------------------------------------------------------------------------

/// Time-boxed iteration that groups in-flight issues. Length defaults to
/// the workspace `cycleLengthDays`, but each cycle stores its own.
model Cycle {
  id           String      @id @default(cuid())
  workspaceId  String
  name         String
  startsAt     DateTime
  endsAt       DateTime
  lengthDays   Int
  cooldownDays Int         @default(0)
  status       CycleStatus @default(PLANNED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status, startsAt])
}

/// Umbrella for related projects. Strategic container above Project.
model Initiative {
  id           String           @id @default(cuid())
  workspaceId  String
  name         String
  slug         String
  description  String?          @db.Text
  targetDate   DateTime?
  color        String?
  status       InitiativeStatus @default(PLANNED)
  position     Int              @default(0)
  createdById  String
  /// Backlink for an initiative created via `notes.promote`.
  sourceNoteId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]
  goals     Goal[]    @relation("InitiativeGoals")

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, position])
}

/// Directed relation between two issues. `kind` captures the semantics.
/// Deleting either endpoint cascades the relation row.
model IssueRelation {
  id          String       @id @default(cuid())
  workspaceId String
  fromIssueId String
  toIssueId   String
  kind        RelationKind
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromIssue Issue     @relation("IssueRelationFrom", fields: [fromIssueId], references: [id], onDelete: Cascade)
  toIssue   Issue     @relation("IssueRelationTo", fields: [toIssueId], references: [id], onDelete: Cascade)

  @@unique([fromIssueId, toIssueId, kind])
  @@index([fromIssueId])
  @@index([toIssueId])
  @@index([workspaceId, kind])
}

/// Time tracking entry. Open entries have `endedAt = null`.
model TimeEntry {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  issueId     String?
  description String?
  startedAt   DateTime
  endedAt     DateTime?
  billable    Boolean   @default(false)
  hourlyRate  Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, startedAt])
  @@index([issueId])
}

// ----------------------------------------------------------------------------
// Runtimes (compute hosts for agents)
// ----------------------------------------------------------------------------

/// A runtime is the compute environment that hosts one or more agents.
/// Distinct from `Agent` so the same agent identity can move between
/// runtimes (e.g. a Hermes profile rehosted from one server to another).
///
/// LOCAL_DAEMON runtimes are registered by `forge daemon` on the user's
/// machine and poll Forge over SSE; they don't expose an inbound URL.
/// REMOTE_HTTP runtimes are the existing Hermes-style webhook receivers
/// — `endpoint` carries the URL, `secret` the HMAC signing key.
model Runtime {
  id                     String                 @id @default(cuid())
  workspaceId            String
  name                   String
  kind                   RuntimeKind
  /// Which provider-agnostic RuntimeAdapter this runtime instances
  /// (`src/server/runtimes/adapters.ts`) — "hermes", "local-daemon",
  /// "custom-http", … Source of truth for "what manages this runtime,"
  /// replacing inference from `kind`. Nullable for back-compat; backfilled
  /// in migration 0059. See `docs/plans/runtime-adapter-refactor.md`.
  adapterKey             String?
  /// Webhook URL for REMOTE_HTTP. Null for LOCAL_DAEMON (the daemon
  /// polls Forge via SSE).
  endpoint               String?
  /// HMAC secret for outbound webhook signing (REMOTE_HTTP only).
  secret                 String?
  /// Providers this runtime can host. For REMOTE_HTTP it's whatever the
  /// operator declares; for LOCAL_DAEMON the daemon reports it from
  /// PATH detection on registration + reconnect.
  providersAvailable     AgentProvider[]        @default([])
  /// Last successful runtime-level heartbeat. Distinct from per-agent
  /// heartbeat: an idle runtime can be alive while no agent on it has
  /// done anything recently.
  heartbeatAt            DateTime?
  /// Last handshake-only reachability probe. This is diagnostic, not a
  /// substitute for adapter-specific presence: Hermes can answer its gateway
  /// probe while still missing the forge-presence/agent heartbeat signal.
  lastProbeAt            DateTime?
  lastProbeAttempted     Boolean                @default(false)
  lastProbeReachable     Boolean?
  lastProbeDetail        String?
  /// Structured version/environment metadata reported by the runtime host or
  /// harvested from a protocol initialize response. Sanitized/whitelisted in
  /// `runtime-info.ts`; safe for operator display, not a raw env dump.
  runtimeInfo            Json?
  lastInfoAt             DateTime?
  /// Last operator-requested self-test turn. Unlike `lastProbe*`, this is a
  /// real minimal adapter run where supported, so it catches provider auth
  /// failures that only surface when starting a turn.
  lastSelfTestAt         DateTime?
  lastSelfTestStatus     RuntimeSelfTestStatus?
  lastSelfTestDetail     String?
  lastSelfTestDurationMs Int?
  /// Last connect time for LOCAL_DAEMON (when the SSE subscription
  /// opened). Null for REMOTE_HTTP.
  connectedAt            DateTime?
  /// Optional auth-token-prefix for the daemon's `forge login` token.
  /// Stored only for ops display; the underlying ApiKey row is the
  /// source of truth.
  ownerKeyPrefix         String?
  /// User who registered this runtime. The global owner — global runtime
  /// views (Mission Control, /settings/runtimes) key off this rather than
  /// `workspaceId`, so a host appears once across all the owner's
  /// workspaces. `workspaceId` is retained (where the daemon first
  /// registered) for back-compat; treat `ownerId` as the global identity.
  ownerId                String?
  /// Instance admin can mark a runtime instance-shared so it appears in
  /// every workspace's runtime picker (not just the owner's). Mirrors
  /// {@link AgentProfile.instanceShared}.
  instanceShared         Boolean                @default(false)
  archivedAt             DateTime?
  /// Soft kill-switch. When set, the runtime is "disabled": dispatch +
  /// chat refuse to dial it (the connector resolves to a sentinel that
  /// reports `[runtime disabled]` rather than opening a session). Distinct
  /// from `archivedAt` (a reversible delete / hide) — `disabledAt` is a
  /// reversible pause that keeps the row visible and configured. Added
  /// 2026-05-24 (migration 0062) for operator control of host-touching
  /// runtimes like the Codex app server.
  disabledAt             DateTime?
  /// Adapter-specific runtime configuration (validated per `adapterKey` in
  /// the runtime router; opaque here). For `codex-app-server` this carries
  /// `{ sandboxMode, approvalPolicy, workspaceRoot }` — the connector sends
  /// them as per-turn `sandboxPolicy`/`approvalPolicy`/`cwd` overrides so an
  /// operator can flip a Codex runtime between full-access (today's default)
  /// and a sandboxed, approval-gated mode without restarting the bridge.
  config                 Json?
  /// Optional link to a workspace-scoped {@link GithubApp} used for git auth.
  /// When set, provisioning mints a short-lived installation token from that
  /// app into `GH_TOKEN` (superseding a static GH_TOKEN secret). One app can
  /// be shared across many runtimes. SetNull so deleting the app just unlinks.
  githubAppId            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  agents        Agent[]         @relation("AgentRuntime")
  agentProfiles AgentProfile[]  @relation("AgentProfileRuntime")
  secrets       RuntimeSecret[]
  repos         RuntimeRepo[]
  githubApp     GithubApp?      @relation(fields: [githubAppId], references: [id], onDelete: SetNull)

  @@index([workspaceId, archivedAt])
  @@index([ownerId])
  @@index([githubAppId])
}

/// A named secret injected into a runtime's environment at provision time
/// (e.g. GH_TOKEN, GIT_SSH_KEY, a deploy credential). The value is encrypted
/// at rest with AES-256-GCM (see `src/server/crypto.ts`) and is NEVER returned
/// to clients — management surfaces show only `key` + metadata. The runtime
/// fetches+decrypts its own secrets via `runtimes.provisioning` (the agent's
/// API key resolves to its runtime), exports them for the agent process, and
/// uses them to set up gh/git auth before the agent's turn.
model RuntimeSecret {
  id          String   @id @default(cuid())
  runtimeId   String
  /// Denormalized for scoping/queries; cascade is via the runtime relation.
  workspaceId String
  /// Environment variable name (e.g. `GH_TOKEN`). Unique per runtime.
  key         String
  /// AES-256-GCM ciphertext of the value. Write-only from the client's POV.
  valueEnc    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runtime Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)

  @@unique([runtimeId, key])
  @@index([runtimeId])
  @@index([workspaceId])
}

/// A repository the runtime should materialize (clone-or-pull) into its
/// workspace so a dispatched agent lands in a ready, up-to-date checkout
/// instead of an operator hand-placing files. Auth comes from the runtime's
/// secrets (e.g. GH_TOKEN drives a git credential helper + `gh`).
model RuntimeRepo {
  id          String   @id @default(cuid())
  runtimeId   String
  workspaceId String
  /// Git remote URL (https — credential-helper supplies the token — or ssh).
  url         String
  /// Branch to track; null = the remote's default branch.
  branch      String?
  /// Clone path relative to the runtime's workspace root (e.g. `forge`).
  path        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runtime Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)

  @@unique([runtimeId, path])
  @@index([runtimeId])
  @@index([workspaceId])
}

/// A **workspace-scoped GitHub App** for runtime git auth — the recommended
/// alternative to a static `GH_TOKEN` PAT. Install ONE app on your org/account,
/// manage which repos it can touch from GitHub's install UI, and **share it
/// across many runtimes** (each `Runtime.githubAppId` points here). At provision
/// time Forge mints a short-lived (≈1h) installation access token and injects it
/// as `GH_TOKEN`, so agents get clone/push/PR access with no long-lived token
/// and no per-repo key. Adding a repo later is a checkbox on GitHub.
///
/// Created two ways: **manifest flow** (GitHub generates the app + returns the
/// private key to our callback — no manual paste) or **manual paste** (App ID +
/// installation ID + PEM). `appId`/`privateKeyEnc` are set at creation;
/// `installationId` is filled after the app is installed (null = "created, not
/// yet installed" — provisioning skips it until installed).
///
/// The private key (PEM) is AES-256-GCM-encrypted at rest (`src/server/crypto.ts`)
/// and NEVER returned to clients; the minted token never touches the DB. App ID,
/// installation ID and slug are non-secret and shown in the management UI.
/// Distinct from the **instance** GitHub App (env-var creds) used for issue
/// sync — see `src/server/services/github/app-auth.ts`.
model GithubApp {
  id                 String    @id @default(cuid())
  workspaceId        String
  /// Operator-facing label (e.g. "Axiom Bot").
  name               String
  /// Numeric GitHub App ID — the JWT issuer used to mint installation tokens.
  appId              String
  /// Installation ID (the app installed on an org/account). Null until the app
  /// is installed; tokens are scoped to whatever repos the installation grants.
  installationId     String?
  /// AES-256-GCM ciphertext of the app's PEM private key. Write-only.
  privateKeyEnc      String
  /// App slug (e.g. `forge-bot`) for deep-linking to GitHub's install/settings
  /// pages. From the manifest conversion, or the first successful test.
  slug               String?
  /// OAuth client id from the manifest conversion (informational; nullable).
  clientId           String?
  /// Created via the manifest flow (vs. manual paste). UI hint only.
  createdViaManifest Boolean   @default(false)
  /// Last successful token mint, for at-a-glance health in the UI.
  lastMintedAt       DateTime?
  /// Last mint/verify error message (cleared on success). UI surfaces it.
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runtimes  Runtime[]

  @@index([workspaceId])
}

/// A per-workspace chat-model credential — lets the Streaming (Completions)
/// engine reach an OpenAI-compatible backend WITHOUT environment variables.
/// `providerId` matches `ai-providers.ts` ProviderId ("openai" | "anthropic"
/// | "custom" | "hermes"). `apiKeyEnc` is AES-256-GCM via `crypto.ts`
/// (never returned to clients — the router redacts to `hasKey`). A DB row
/// takes precedence over env for that provider; env remains the fallback.
model ProviderCredential {
  id           String   @id @default(cuid())
  workspaceId  String
  /// ai-providers ProviderId this credential configures.
  providerId   String
  /// Optional human label for the connection.
  label        String?
  /// Override base URL (OpenAI-compatible). Null = provider default.
  baseUrl      String?
  /// Encrypted API key (AES-256-GCM). Null = no key stored.
  apiKeyEnc    String?
  /// Default model for this provider in this workspace. Null = provider default.
  defaultModel String?
  /// When false, the credential is ignored (falls back to env).
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerId])
  @@index([workspaceId])
}

/// A global, user-owned external **identity** (OAuth / OIDC). Distinct
/// from {@link ProviderCredential} (per-workspace AI model creds) and
/// {@link SsoProvider} (instance sign-in). A Connection is *you* — your
/// GitHub login, your Slack auth, your Authelia OIDC identity — defined
/// once at the account level and *mapped* into workspaces via
/// {@link ConnectionMapping}. The same GitHub identity can map to
/// different repos in different workspaces (same token, different
/// mapping). Token material is encrypted (`tokenEnc`, AES-256-GCM via
/// crypto.ts) and never returned to clients.
model Connection {
  id        String             @id @default(cuid())
  ownerId   String
  provider  ConnectionProvider
  /// Human label, e.g. "github.com/bailey" or "Forge · #ops".
  label     String
  /// Display handle of the connected account (not a secret).
  account   String?
  status    ConnectionStatus   @default(DISCONNECTED)
  /// Granted scopes (display + enforcement hint).
  scopes    String[]           @default([])
  /// Non-secret provider config: issuer / authUrl / tokenUrl / clientId
  /// / userinfo endpoints for OIDC and generic OAuth. Shape varies by
  /// `provider`; validated in the connections router.
  config    Json?
  /// Encrypted token blob (AES-256-GCM). Null = no live token yet
  /// (manual / pending). Redacted to `hasToken` by the router.
  tokenEnc  String?
  /// Last error surfaced for the connection (e.g. "token expires in 7d").
  error     String?
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  owner    User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mappings ConnectionMapping[]

  @@index([ownerId])
  @@index([provider])
}

/// Per-workspace mapping of a global {@link Connection} to a concrete
/// target (a repo, a channel, a webhook). Identities live at the account
/// level; workspaces decide what they map to. Read-only-cross-workspace:
/// a mapping always carries its `workspaceId`.
model ConnectionMapping {
  id           String   @id @default(cuid())
  workspaceId  String
  connectionId String
  /// "repo" | "channel" | "webhook".
  kind         String
  /// External target: repo full name, channel name, or webhook URL.
  target       String
  /// "inbound" | "outbound" | "inbound+outbound".
  direction    String   @default("inbound+outbound")
  /// Default label ids applied to inbound work from this mapping.
  labelIds     String[] @default([])
  /// Where inbound events route (freeform display: "Dispatch matrix",
  /// "Issue · auto-create", "Chat · @victor", …).
  routeTo      String?
  /// "active" | "paused".
  status       String   @default("active")
  /// Mapping-specific config (trigger filters, branch globs, …).
  config       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection        Connection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalResources ExternalResource[]

  @@index([workspaceId])
  @@index([connectionId])
}

/// Workspace-scoped snapshot of an object in an external work system.
/// GitHub is the first provider; the table stays provider-generic so
/// future integrations can reuse the identity/link/sync layer without
/// adding a parallel model per vendor.
model ExternalResource {
  id                  String    @id @default(cuid())
  workspaceId         String
  /// Provider key, e.g. "GITHUB".
  provider            String
  /// Optional repo/channel/webhook mapping that supplied this resource.
  connectionMappingId String?
  /// Provider object type, e.g. "ISSUE" or "PULL_REQUEST".
  resourceType        String
  /// Repository full name for GitHub resources (`owner/name`).
  repoFullName        String
  /// Provider numeric id, stored as string because providers differ.
  externalId          String?
  /// Provider stable node id when available.
  externalNodeId      String?
  number              Int
  url                 String
  apiUrl              String?
  title               String
  /// Provider state snapshot (`open`, `closed`, `merged`, `draft`, ...).
  state               String
  authorLogin         String?
  labels              Json?
  assignees           Json?
  /// Bounded provider-specific metadata such as PR checks/review state.
  metadata            Json?
  externalCreatedAt   DateTime?
  externalUpdatedAt   DateTime?
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionMapping ConnectionMapping?     @relation(fields: [connectionMappingId], references: [id], onDelete: SetNull)
  links             ExternalResourceLink[]

  @@unique([workspaceId, provider, repoFullName, resourceType, number])
  @@index([workspaceId, provider, repoFullName])
  @@index([workspaceId, provider, externalNodeId])
  @@index([connectionMappingId])
}

/// Join between a Forge issue and an external resource. The link kind is
/// intentionally a string so integrations can add new semantics without
/// forcing a core enum migration for every provider-specific relation.
model ExternalResourceLink {
  id                 String   @id @default(cuid())
  workspaceId        String
  issueId            String
  externalResourceId String
  /// SOURCE | IMPLEMENTS | REVIEWS | RELATES_TO.
  kind               String
  createdById        String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue            Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  externalResource ExternalResource @relation(fields: [externalResourceId], references: [id], onDelete: Cascade)
  createdBy        User?            @relation("ExternalResourceLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([issueId, externalResourceId, kind])
  @@index([workspaceId, issueId])
  @@index([workspaceId, externalResourceId])
  @@index([createdById])
}

/// Inbound external webhook idempotency and diagnostics. For GitHub this
/// stores `X-GitHub-Delivery` plus event/action so redeliveries can be
/// acknowledged without duplicating Forge side effects.
model ExternalWebhookEvent {
  id                 String    @id @default(cuid())
  workspaceId        String?
  provider           String
  deliveryId         String
  event              String
  action             String?
  repoFullName       String?
  externalResourceId String?
  status             String
  error              String?   @db.Text
  receivedAt         DateTime  @default(now())
  processedAt        DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([provider, deliveryId])
  @@index([workspaceId, status, receivedAt])
  @@index([provider, repoFullName])
}

// ----------------------------------------------------------------------------
// Agents (MCP-first actors)
// ----------------------------------------------------------------------------

/// Registered agent identity. Distinct from User (humans) — agents may be
/// LLM profiles (e.g. `victor`, `mizu`) that authenticate via ApiKey and
/// receive work via webhook push. `profileKey` is the stable, human-memorable
/// handle used across Hermes and Forge (matches Hermes profile directory name).
/// Global, user-owned agent **definition**. The source of truth for an
/// agent's identity and base capabilities, independent of any workspace.
/// A workspace adopts a profile by creating an {@link Agent} *binding*
/// (`Agent.profileId`) which carries per-workspace policy. `profileKey`
/// is the stable cross-system handle (matches the Hermes profile dir);
/// it is unique **per owner**, so two users can each own a `victor`.
///
/// Definitional columns (provider, runEngine, runtimeId, capabilities,
/// avatar, webhook, template) are duplicated onto the binding during the
/// expand/contract transition — the binding values are *effective /
/// override*, the profile is canonical. New consumers should prefer
/// `profile.*` and fall back to the binding's own column when
/// `profileId` is null (un-backfilled rows).
model AgentProfile {
  id               String           @id @default(cuid())
  /// User who owns / defined this profile.
  ownerId          String
  /// Stable handle, unique per owner. Maps to a Hermes profile dir name.
  profileKey       String
  name             String
  description      String?          @db.Text
  avatar           String?
  provider         AgentProvider    @default(HERMES)
  runtimeMode      AgentRuntimeMode @default(PERSISTENT)
  /// Null = use the integration's default (see adapters.ts).
  runEngine        RunEngine?
  /// Outbound webhook for the BYO/custom-webhook push path (override).
  webhookUrl       String?
  webhookSecret    String?
  /// Global runtime that hosts this profile by default. Null = unbound.
  runtimeId        String?
  /// Base capability tags. Bindings inherit these and may override
  /// (add/remove) per workspace via `Agent.capabilities`.
  baseCapabilities String[]         @default([])
  role             AgentRole        @default(WORKER)
  templateMarkdown String?          @db.Text
  /// Instance admin governance: when true the profile appears in every
  /// workspace's bind-catalog (not just the owner's workspaces).
  instanceShared   Boolean          @default(false)
  /// Instance admin force-disable. When set, the profile (and all its
  /// bindings) refuse dispatch/chat. Distinct from `archivedAt`.
  disabledAt       DateTime?
  archivedAt       DateTime?
  /// Profile-request flow: a member can request a profile (creating it
  /// with `requestedById` set and `approvedAt` null = pending). An
  /// instance admin approves (`approvedAt` set) or rejects (archived).
  /// Profiles created directly by an instance admin have `approvedAt`
  /// set at creation and `requestedById` null. A pending profile is not
  /// bindable until approved.
  requestedById    String?
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("AgentProfileRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  runtime     Runtime? @relation("AgentProfileRuntime", fields: [runtimeId], references: [id], onDelete: SetNull)
  bindings    Agent[]  @relation("AgentProfileBinding")

  @@unique([ownerId, profileKey])
  @@index([ownerId])
  @@index([instanceShared])
  @@index([runtimeId])
  @@index([requestedById])
}

model Agent {
  id                         String           @id @default(cuid())
  workspaceId                String
  /// The global definition this binding adopts. Nullable during the
  /// expand/contract migration (un-backfilled rows are null); the
  /// backfill script links each binding to a profile. Once fully
  /// backfilled this becomes the definitional source of truth.
  profileId                  String?
  /// Per-binding auto-dispatch eligibility. When false, the agent is
  /// never auto-picked (manual assignment only) even if WORKER. Mirrors
  /// the design's per-binding `autoDispatch` toggle; independent of the
  /// workspace `autoDispatchMode`.
  autoDispatchEligible       Boolean          @default(true)
  /// Per-binding engagement-mode override. Null = inherit the workspace
  /// default (`Workspace.assignmentEngagementMode`).
  engagementMode             EngagementMode?
  /// Per-binding gate: when true, dispatched work for this agent waits
  /// for human approval before the run starts, overriding the workspace
  /// `requireApprovalBeforeStart` for this binding only.
  requireApprovalBeforeStart Boolean          @default(false)
  name                       String
  /// Stable handle for cross-system lookup. Unique per workspace.
  profileKey                 String
  description                String?          @db.Text
  /// Avatar/emoji or URL — freeform. UI decides.
  avatar                     String?
  provider                   AgentProvider    @default(HERMES)
  runtimeMode                AgentRuntimeMode @default(PERSISTENT)
  /// Which execution engine drives this agent. Null = use the
  /// integration's default (see `adapters.ts` `defaultRunEngine`).
  /// COMPLETIONS = Forge owns the loop via OpenAI-compat
  /// `/v1/chat/completions` (stateless, fast token streaming);
  /// RUNS = delegate to the provider's structured agent-run API
  /// (Hermes `/v1/runs` — agent runs as itself with memory/tools,
  /// streams `message.delta` + lifecycle events, native approval/stop).
  /// Dispatch (assigned work) always uses RUNS when the connector
  /// supports it; this column governs the interactive chat surface.
  runEngine                  RunEngine?
  /// Outbound webhook for push dispatch (issue.assigned etc) — the BYO /
  /// custom-webhook path and a per-agent OVERRIDE. As of the runtime-adapter
  /// refactor the managed Runtime owns the *runs* loop endpoint
  /// (`Runtime.endpoint`, see getRunsConnectorForAgent); this column is the
  /// override for agents that receive push delivery (RUNS-engine agents have
  /// it suppressed — they're dispatched via the runs API). Retained, not
  /// dropped: it backs the custom-webhook agent feature.
  webhookUrl                 String?
  /// Optional HMAC secret for webhook signing; falls back to the
  /// workspace-level synthetic webhook secret when unset. Per-agent override,
  /// same status as `webhookUrl`.
  webhookSecret              String?
  /// Runtime that hosts this agent. Null = legacy / unbound. SetNull on
  /// runtime delete so the agent row survives runtime churn.
  runtimeId                  String?
  /// Free-form capability tags (e.g. "ops", "research", "code-review").
  /// Consumed by `autoDispatchMode = CAPABILITY_MATCH`.
  capabilities               String[]         @default([])
  /// Distinguishes WORKER (claims work, default) from COACH (observes
  /// events and posts diagnostic comments) and OBSERVER (read-only).
  /// Auto-dispatch only considers WORKER agents.
  role                       AgentRole        @default(WORKER)
  /// Optional markdown template auto-applied to an issue's description on
  /// assignment, when the description is empty. Freeform (no length cap).
  /// See `src/server/services/agent-template.ts`.
  templateMarkdown           String?          @db.Text
  status                     AgentStatus      @default(OFFLINE)
  lastHeartbeatAt            DateTime?
  /// Cap on simultaneously-claimed issues. 0 = unlimited.
  maxConcurrent              Int              @default(1)
  /// Timestamp of the last auto-dispatch assignment to this agent. Used by
  /// `AutoDispatchMode.ROUND_ROBIN` to pick the least-recent pick.
  lastDispatchedAt           DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  workspace                Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile                  AgentProfile?     @relation("AgentProfileBinding", fields: [profileId], references: [id], onDelete: SetNull)
  runtime                  Runtime?          @relation("AgentRuntime", fields: [runtimeId], references: [id], onDelete: SetNull)
  assignedIssues           Issue[]           @relation("IssueAssignedAgent")
  claimedIssues            Issue[]           @relation("IssueClaimedByAgent")
  apiKeys                  ApiKey[]          @relation("AgentApiKeys")
  authoredComments         Comment[]         @relation("AgentAuthoredComments")
  dispatchRules            DispatchRule[]
  runs                     AgentRun[]
  chatThreads              ChatThread[]
  issueWatches             IssueWatcher[]
  authoredArtifacts        Artifact[]        @relation("ArtifactCreatorAgent")
  authoredArtifactVersions ArtifactVersion[] @relation("ArtifactVersionCreatorAgent")
  ownedContextSets         ContextSet[]      @relation("ContextSetOwnerAgent")
  createdExecutionPlans    ExecutionPlan[]   @relation("ExecutionPlanCreatorAgent")
  createdGoals             Goal[]            @relation("GoalCreatorAgent")
  executionSteps           ExecutionStep[]   @relation("ExecutionStepAgent")
  crewMemberships          AgentCrewMember[] @relation("AgentCrewMember")
  requestedReviewGates     ReviewGate[]      @relation("ReviewGateRequesterAgent")
  resolvedReviewGates      ReviewGate[]      @relation("ReviewGateResolverAgent")
  requestedActionRequests  ActionRequest[]   @relation("ActionRequestRequesterAgent")
  assignedActionRequests   ActionRequest[]   @relation("ActionRequestAssigneeAgent")
  actorAuditLogs           AuditLog[]        @relation("AuditLogActorAgent")
  actorActivityEvents      ActivityEvent[]   @relation("ActivityEventActorAgent")

  @@unique([workspaceId, profileKey])
  @@index([workspaceId, status])
  @@index([runtimeId])
  @@index([profileId])
}

/// Declarative routing layer consulted before the `AutoDispatchMode` logic
/// when a queued, unassigned issue enters the dispatcher. Each rule pins
/// an arbitrary (priority, labelId, projectId) combination to a single
/// target agent; null condition columns are wildcards (match anything).
/// Rules are evaluated in `order ASC, createdAt ASC` and the first match
/// wins. If the target is not eligible (archived / OFFLINE / at cap) the
/// dispatcher falls through to mode-based selection rather than stalling.
model DispatchRule {
  id          String  @id @default(cuid())
  workspaceId String
  /// Human-readable label. Surfaced verbatim in the admin UI.
  name        String
  enabled     Boolean @default(true)
  /// Lower values evaluate first. Stable tiebreak on `createdAt ASC`.
  order       Int

  // Conditions — all non-null columns must match the incoming issue. A
  // row with every condition null matches every issue (catch-all).
  priority  Priority?
  labelId   String?
  projectId String?

  /// Agent to assign when the rule fires. Restrict so that you can't
  /// accidentally delete an agent that still has rules pointing at it.
  targetAgentId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  label       Label?    @relation(fields: [labelId], references: [id], onDelete: SetNull)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  targetAgent Agent     @relation(fields: [targetAgentId], references: [id], onDelete: Restrict)

  @@index([workspaceId, enabled, order])
}

// ----------------------------------------------------------------------------
// Agent runs (live monitoring)
// ----------------------------------------------------------------------------

/// One AgentRun row per "the agent is actively working this issue" cycle.
/// Opens on the first activity from the assigned agent against the issue
/// (status comment upsert, MCP write, transition out of TODO/BACKLOG, …).
/// Closes when the issue transitions to a terminal status, the agent
/// reports completion, or the watchdog flags it stalled. Multiple runs
/// can exist over an issues lifetime if it is re-dispatched. The single
/// 1:1 STATUS Comment for this run is referenced via Comment.runId.
model AgentRun {
  id                   String               @id @default(cuid())
  workspaceId          String
  issueId              String
  agentId              String
  status               AgentRunStatus       @default(ACTIVE)
  startedAt            DateTime             @default(now())
  /// Updated on every appended AgentRunEvent — what the watchdog reads.
  lastEventAt          DateTime             @default(now())
  finishedAt           DateTime?
  /// Compact label rendered by the live pulse strip ("running tests").
  currentStep          String?
  /// Optional final summary populated when the agent reports completion.
  summary              String?              @db.Text
  /// Optional list of artifact ids the agent produced for this run.
  /// Populated by `runs.complete` so the UI can render evidence links
  /// alongside the summary.
  producedArtifactIds  String[]             @default([])
  /// Optional structured verification result: snapshot of the issue's
  /// verificationChecklist at completion time with `done` flags set.
  verificationResult   Json?
  /// Optional list of follow-up items the agent flagged for next steps.
  /// Shape: array of `{ title: string, body?: string, kind?: string }`.
  followUps            Json?
  /// Mode-specific structured completion metadata. Examples:
  /// `{ confidence: "HIGH" }` for RESEARCH, `{ verdict: "APPROVE" }`
  /// for REVIEW, plus the Forge run contract version used at completion.
  completionMeta       Json?
  /// Provider-side run id when this AgentRun is backed by a structured
  /// agent-run connector (e.g. Hermes `/v1/runs`). Lets Forge poll /
  /// approve / stop the live run and correlate streamed `/events`.
  /// Null for webhook/completions-driven runs.
  externalRunId        String?
  /// Effective runtime/tool policy snapshot captured at dispatch. Stored
  /// on the run so old cards remain truthful after Runtime.config changes.
  runtimePolicy        Json?
  /// Set when a connector-driven run is paused awaiting operator
  /// permission (e.g. Hermes flagged a dangerous command). Drives the
  /// Approve/Reject affordance in the Live tab; cleared when the run
  /// resumes (approved) or finishes (rejected/stopped). The stale
  /// watchdog skips runs with this set so a blocked run isn't
  /// misclassified as STALLED.
  awaitingApprovalAt   DateTime?
  /// Detail of the pending approval captured from the live `/events`
  /// stream (Hermes `approval.request`): `{ command, description,
  /// choices }`. Lets the Live-tab banner show *what* is being approved,
  /// not just that something is. Null when not blocked.
  pendingApproval      Json?
  /// Optional pointer at the AGENT_ASSIGNED ActivityEvent that triggered
  /// this run. Useful for ack-window reasoning later.
  assignmentEventId    String?
  /// ActivityEvent.id that *caused* the most recent wake. For
  /// AGENT_ASSIGNED runs this mirrors `assignmentEventId`; for runs
  /// kept warm by mentions / priority bumps / watcher fan-out it holds
  /// the latest trigger so the inbox can distinguish "Victor was just
  /// re-mentioned" from "Victor is the static assignee".
  triggerEventId       String?
  /// String mirror of ActivityEvent.kind for the latest trigger. Not
  /// enum-typed on purpose — EventKind grows and we don't want to
  /// migrate AgentRun every time. Conventional values: AGENT_ASSIGNED,
  /// ISSUE_QUEUED, ISSUE_PRIORITY_CHANGED, COMMENT_CREATED,
  /// CHAT_MESSAGE_POSTED.
  triggerKind          String?
  /// Set when the assigned agent has acknowledged the dispatch and
  /// intends to act on it. Drives the UI transition from "wake sent" →
  /// "acknowledged" and silences the chat typing animation diagnostic.
  acknowledgedAt       DateTime?
  /// Set the first time the agent's reply / status / step output lands.
  /// Drives the UI transition from "acknowledged" → "running".
  outputStartedAt      DateTime?
  /// Worker-side: latest wake attempt timestamp regardless of HTTP
  /// success. Diagnostic only — canonical work state lives elsewhere.
  lastWakeAt           DateTime?
  /// Number of wake attempts the worker has made for this run. Distinct
  /// from WebhookDelivery.attempt (which counts retries on one row).
  wakeAttempts         Int                  @default(0)
  /// Optional pointer at the most recent WebhookDelivery so the
  /// diagnostics panel can link straight to the (potentially failed)
  /// delivery row.
  lastWakeDeliveryId   String?
  /// Token-usage telemetry reported by the agent via `runs.recordUsage`.
  /// Cumulative as reported — the latest call replaces the prior values
  /// (idempotent), so agents should send running totals, not per-step
  /// deltas. Null = agent did not report.
  tokensIn             Int?
  tokensOut            Int?
  tokensCached         Int?
  /// Cost the agent attributes to the run, in USD. Source-of-truth is
  /// the agent's own pricing knowledge for v1; a server-side rate table
  /// is a future cleanup.
  costUsd              Decimal?             @db.Decimal(10, 4)
  /// Operator-requested control signal. NONE is the steady state;
  /// PAUSE_REQUESTED / CANCEL_REQUESTED are pending instructions for
  /// the agent's runtime to honor on its next loop tick. The runtime
  /// is responsible for resetting to NONE once it acts (or for
  /// transitioning the run to an appropriate terminal state on
  /// CANCEL). Webhook fan-out via `recordChange` carries the same
  /// payload to the agent's `webhookUrl`.
  controlState         AgentRunControlState @default(NONE)
  /// When the most recent control was requested. Null when
  /// `controlState = NONE` (no signal pending).
  controlRequestedAt   DateTime?
  /// User who requested the control. SetNull on user delete so the
  /// run row survives membership churn.
  controlRequestedById String?
  /// Operator-cleared terminal failures stay in durable history but are
  /// hidden from Command Center / pipeline failure queues by default.
  clearedAt            DateTime?
  /// User who cleared the terminal failure from operational surfaces.
  /// SetNull on user delete so the run row survives membership churn.
  clearedById          String?
  /// Set when a newer run for the same (issue, agent) supersedes this
  /// one (added 2026-06-23). A re-dispatch / kick / grant that opens a
  /// fresh run links the prior STALLED/abandoned attempts here so
  /// operator surfaces collapse the stack into one thread instead of
  /// showing N repeated cards (the AXI-75 pathology). The run keeps its
  /// own terminal status for history; surfaces filter on
  /// `supersededByRunId IS NULL` to show only the head of each chain.
  supersededByRunId    String?
  /// Set only by clean completion via `runs.complete` (added
  /// 2026-06-23). Distinct from `finishedAt`, which is stamped for ANY
  /// terminal transition (including STALLED/ABANDONED). Rollups/surfaces
  /// that mean "succeeded" key off `completedAt`, not `finishedAt`.
  completedAt          DateTime?

  /// Optional ExecutionStep this run is executing (migration: AXI-57). Set
  /// when the Goal-orchestration loop opens a run for a step, so orchestrated
  /// turns are first-class observable runs (Mission Control / watchdog / cost)
  /// — not fire-and-forget webhooks. Null for direct-dispatch runs.
  executionStepId  String?
  /// The engagement mode resolved for this run (AXI-53). Governs the
  /// completion contract: only EXECUTE auto-transitions the issue, is held to
  /// the SLA/watchdog "must move the issue" expectation, and enforces
  /// artifact/verification gates. See docs/agents/engagement-modes.md.
  engagementMode   EngagementMode    @default(EXECUTE)
  /// How `engagementMode` was decided at dispatch (Phase 2, 2026-06-23). Frozen
  /// for the source tooltip. Nullable: null = legacy/unstamped (distinct from a
  /// stamped SURFACE_DEFAULT). Set at the single persistence point in
  /// `openOrTouchRun`; on update only a fresh assignment re-stamps it (so the
  /// sticky-active-run tier isn't clobbered by incidental touches).
  engagementSource EngagementSource?
  /// Effective run engine resolved at dispatch via `resolveRunEngineWithSource`
  /// and frozen here so run-scoped consumers (kick, Mission Control) read the
  /// stamped value instead of re-resolving against later Agent.runEngine /
  /// Runtime changes. Null = legacy/unstamped. Distinct from `Agent.runEngine`
  /// (the agent's *preference*); this is what actually ran.
  runEngine        RunEngine?
  /// Free-form resolution source for `runEngine` (display-only, never queried):
  /// agent-explicit | runtime-adapter | provider-default | fallback. String,
  /// not an enum, for the same anti-churn reason as `triggerKind`.
  runEngineSource  String?

  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue              Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  agent              Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  executionStep      ExecutionStep?  @relation("AgentRunStep", fields: [executionStepId], references: [id], onDelete: SetNull)
  controlRequestedBy User?           @relation("AgentRunControlRequester", fields: [controlRequestedById], references: [id], onDelete: SetNull)
  clearedBy          User?           @relation("AgentRunClearer", fields: [clearedById], references: [id], onDelete: SetNull)
  supersededBy       AgentRun?       @relation("AgentRunSupersede", fields: [supersededByRunId], references: [id], onDelete: SetNull)
  supersedes         AgentRun[]      @relation("AgentRunSupersede")
  events             AgentRunEvent[]
  statusComment      Comment?        @relation("AgentRunStatusComment")

  @@index([workspaceId, status, lastEventAt])
  @@index([workspaceId, status, clearedAt, lastEventAt])
  @@index([issueId, startedAt])
  @@index([agentId, status])
  /// Inbox query: "what does Victor owe right now?" Filters unacked
  /// (acknowledgedAt IS NULL) active runs ordered by recency.
  @@index([workspaceId, agentId, acknowledgedAt, lastEventAt])
  /// Reverse lookup from an ActivityEvent to its canonical run.
  @@index([workspaceId, triggerEventId])
  @@index([executionStepId])
  /// Collapse stacked runs: list heads with `supersededByRunId IS NULL`,
  /// expand a thread by following the chain.
  @@index([supersededByRunId])
  /// Cross-tenant worker sweeps (pollActiveRuns / ensureSubscriptions /
  /// stale watchdog) filter on `status` with NO workspaceId, so the
  /// workspaceId-leading indexes above can't serve them and they seq-scan
  /// every 5s/60s. A status-leading index keeps those hot sweeps off a
  /// sequential scan as AgentRun history grows.
  @@index([status, lastEventAt])
  /// Dedup lookup on the dispatch path: has this AGENT_ASSIGNED event
  /// already opened a run for the agent?
  @@index([assignmentEventId])
}

/// Append-only timeline for an AgentRun. Drives the live pulse strip and
/// the watchdog freshness check. `kind` is intentionally a free-form
/// string (not an enum) so agents can stamp arbitrary step names from
/// their loop without schema churn — STARTED, STEP, TOOL_CALL, STATUS,
/// BLOCKED, COMPLETED, ERRORED, … are conventional.
model AgentRunEvent {
  id          String   @id @default(cuid())
  workspaceId String
  runId       String
  kind        String
  payload     Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run       AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([workspaceId, createdAt])
}

model ChatThread {
  id                       String          @id @default(cuid())
  workspaceId              String
  userId                   String
  agentId                  String
  title                    String?
  topic                    String?
  isDefault                Boolean         @default(false)
  contextMode              ChatContextMode @default(SMART)
  summaryMarkdown          String?         @db.Text
  summarizedUntilMessageId String?
  summarizedAt             DateTime?
  /// Per-thread override of the agent's default provider. Null = use
  /// `Agent.provider`. Picked up by /api/chat/stream when building the
  /// upstream request.
  providerOverride         AgentProvider?
  /// Per-thread override of the provider's default model. Null = use
  /// the provider's `defaultModel` from `ai-providers.ts`.
  modelOverride            String?
  /// Per-thread override of runtime YOLO/approval bypass. Null = inherit the
  /// runtime config; true/false force the permission mode for this thread.
  yoloModeOverride         Boolean?
  lastMessageAt            DateTime        @default(now())
  createdAt                DateTime        @default(now())
  archivedAt               DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  reads     ChatThreadRead[]

  @@index([workspaceId, userId, agentId, lastMessageAt])
  @@index([workspaceId, userId, archivedAt, lastMessageAt])
}

model ChatThreadRead {
  id          String   @id @default(cuid())
  workspaceId String
  threadId    String
  userId      String
  readAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([workspaceId, userId, readAt])
}

model ChatMessage {
  id                 String    @id @default(cuid())
  workspaceId        String
  threadId           String
  role               ChatRole
  body               String    @db.Text
  contextSnapshot    Json?
  sourceRunId        String?
  /// Set when a USER message has emitted CHAT_MESSAGE_POSTED and is safe
  /// for agent dispatch. Null means the message is still pending upload /
  /// attachment finalization, or is an agent/system message that is not
  /// dispatched to an agent.
  dispatchedAt       DateTime?
  /// Set when the addressed agent has acknowledged this user turn via
  /// `agent.inbox.ack`. Drives the UI transition from "wake sent" →
  /// "acknowledged". Only meaningful when role = USER.
  acknowledgedAt     DateTime?
  /// Set when the agent's reply draft is first written (via
  /// `chat.startDraft`) or finalized in one shot. Drives the typing
  /// animation in the chat panel.
  outputStartedAt    DateTime?
  /// Worker-side: latest wake attempt timestamp regardless of HTTP
  /// success. Bumped on every WebhookDelivery for the addressed agent.
  lastWakeAt         DateTime?
  /// Number of wake attempts the worker has made for this message.
  wakeAttempts       Int       @default(0)
  /// Optional pointer at the most recent WebhookDelivery so the
  /// diagnostics rail can link straight to the failed delivery row.
  lastWakeDeliveryId String?
  createdAt          DateTime  @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([workspaceId, createdAt])
  /// Inbox: USER messages addressed to an agent that haven't been
  /// acknowledged yet. The agent reads its own pending turns via this.
  @@index([threadId, role, acknowledgedAt])
}

// ----------------------------------------------------------------------------
// Pinning + recents (per-user UX surfaces)
// ----------------------------------------------------------------------------

/// Polymorphic per-user pin. Replaces the legacy `User.pinnedIssueIds`
/// string-array column (dropped in migration 0023). Each row pins one
/// entity (Issue / Project / Initiative / SavedView / Cycle / Agent)
/// for the owning user.
///
/// `workspaceId` is nullable — null means a "cross-workspace" pin
/// (the existing topbar-strip semantic where the user pinned an issue
/// from any workspace they're in). Non-null means the pin is scoped
/// to that workspace's sidebar.
///
/// `targetId` is intentionally NOT a foreign key — the table is
/// polymorphic across multiple targetType tables. Hydration in the
/// pin router silently skips dead targets so soft-deleted rows stay
/// inert without breaking listings.
model Pin {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String?
  targetType  PinTargetType
  targetId    String
  /// Lower = earlier in the rendered pin list. Stable across mutates
  /// within a (userId, workspaceId) scope.
  orderIndex  Int           @default(0)
  createdAt   DateTime      @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, targetType, targetId])
  @@index([userId, workspaceId, orderIndex])
  @@index([userId, targetType, targetId])
}

/// LRU-ish per-(user, workspace, target) recent-item record. Upserted
/// on every visit; `visitedAt` becomes the recency key. Used by the
/// command palette empty-state and the recent-items rail. Server-side
/// debounce skips re-upserts within 5 seconds to keep navigations
/// from spamming writes.
model RecentItem {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  targetType  PinTargetType
  targetId    String
  visitedAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, targetType, targetId])
  @@index([userId, workspaceId, visitedAt(sort: Desc)])
}

// ----------------------------------------------------------------------------
// Quick Notes (per-user markdown scratchpad)
// ----------------------------------------------------------------------------

/// Per-(workspace, user) markdown note. Surfaced via the dashboard
/// `<QuickNotesWidget />` and the `notes.*` MCP namespace so agents can
/// leave themselves reasoning scratchpads. Pinned notes float to the top;
/// `archivedAt` is the soft-delete path (hard delete is rare). Convert
/// to a full Issue via `note.convertToIssue` — the source note is left
/// in place so the user can archive it separately.
model Note {
  id             String     @id @default(cuid())
  workspaceId    String
  userId         String
  title          String?
  body           String     @db.Text
  pinned         Boolean    @default(false)
  /// Variant — NOTE (scratchpad) vs JOURNAL (daily summary). JOURNAL
  /// entries are pinned to `journalDate` and unique per user per day,
  /// so `notes.todayJournal` can upsert idempotently.
  kind           NoteKind   @default(NOTE)
  /// Lifecycle status. NOTE-kind rows default to IDEA (fresh capture);
  /// JOURNAL-kind rows default to ACTIVE since they're durable records,
  /// not pitches. Status drives dashboard zone routing and chip color.
  status         NoteStatus @default(IDEA)
  /// Calendar date for JOURNAL entries (UTC midnight, normalized in the
  /// caller's timezone). Null for NOTE rows. Unique with (workspaceId,
  /// userId) — Postgres allows multiple NULLs through a unique
  /// constraint, so NOTE rows are unaffected.
  journalDate    DateTime?
  /// Forward link captured when `notes.promote` spins up a downstream
  /// entity from this note. `promotedToType` is one of "issue" |
  /// "project" | "initiative"; `promotedToId` references the row.
  /// Null = note has not been promoted. The downstream entity also
  /// carries `sourceNoteId` so the link is bidirectional.
  promotedToType String?
  promotedToId   String?
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, journalDate])
  @@index([workspaceId, userId, archivedAt, pinned, updatedAt])
  @@index([workspaceId, userId, kind, journalDate])
  @@index([workspaceId, userId, status, updatedAt])
}

/// Per-(issue, user OR agent) subscription row. A watcher receives
/// fan-out notifications for every event whose subject is the watched
/// issue (delivered via the same per-agent dispatch shim used for
/// comment @-mentions, or the in-app inbox/notification surface for
/// human watchers). Either `userId` or `agentId` must be set — never
/// both, never neither (enforced in the handler; the unique
/// constraints prevent duplicates per identity).
///
/// Pin (UI shortcut) and Watch (event subscription) are intentionally
/// orthogonal — both can be active on the same issue simultaneously.
model IssueWatcher {
  id             String   @id @default(cuid())
  workspaceId    String
  issueId        String
  userId         String?
  agentId        String?
  /// Agent-only fan-out switch. A watcher row means "subscribed for
  /// awareness"; this flag additionally means "wake this agent for future
  /// issue activity." Human watchers ignore it. Current assigned agents get
  /// it enabled; former assigned agents keep watching but are demoted so they
  /// do not receive ghost work after reassignment.
  wakeOnActivity Boolean  @default(false)
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@unique([issueId, agentId])
  @@index([workspaceId, userId])
  @@index([workspaceId, agentId])
  @@index([issueId])
}

// ----------------------------------------------------------------------------
// Agentic work OS — Artifact primitive (added 2026-05-19, migration 0032)
// ----------------------------------------------------------------------------

/// A durable, versionable output object. Captures the long-lived
/// outputs of agent/human work: specs, decisions, runbooks, reports,
/// briefs, verification logs, and accepted agent deliverables.
///
/// `slug` is unique per workspace and lets the URL stay stable across
/// title edits. `currentVersionId` points at the published version
/// rendered by the artifact route; null means the artifact has only
/// the head row (no version history yet).
///
/// `sourceType` + `sourceId` form a polymorphic backlink: when the
/// artifact was promoted from a chat message, comment, note, or
/// agent-run summary, those fields point at the source row so the UI
/// can render "from chat message in #thread" provenance.
model Artifact {
  id               String         @id @default(cuid())
  workspaceId      String
  title            String
  /// URL-friendly identifier, unique per workspace. Stable across
  /// title edits; populated server-side at create time.
  slug             String
  type             ArtifactType   @default(DOCUMENT)
  status           ArtifactStatus @default(DRAFT)
  /// Canonical published body. Edits append a new ArtifactVersion
  /// and (when published) update this column. Markdown.
  body             String         @db.Text
  /// Optional short summary used by list cards + agent context bundles.
  summary          String?        @db.Text
  createdById      String?
  createdByAgentId String?
  /// Polymorphic source ref for promotions: chat-message, comment,
  /// note, agent-run, issue, etc. Null for artifacts created from
  /// scratch.
  sourceType       String?
  sourceId         String?
  /// Pointer at the currently-published ArtifactVersion. Null until
  /// the first publish; thereafter set to the latest accepted version.
  currentVersionId String?
  /// Optional convenience pointers — surface artifacts in their
  /// owning issue/project's detail panels without joining ContextSet.
  /// Both are nullable + indexed.
  issueId          String?
  projectId        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  archivedAt       DateTime?

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("ArtifactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByAgent Agent?            @relation("ArtifactCreatorAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  issue          Issue?            @relation(fields: [issueId], references: [id], onDelete: SetNull)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions       ArtifactVersion[]
  currentVersion ArtifactVersion?  @relation("ArtifactCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, type, updatedAt])
  @@index([issueId])
  @@index([projectId])
}

/// Append-only revision row for an Artifact. Every edit creates a new
/// version; the artifact's `currentVersionId` is updated when the
/// version is published. Soft-delete on the parent Artifact cascades
/// here; individual versions are never hard-deleted.
model ArtifactVersion {
  id               String   @id @default(cuid())
  workspaceId      String
  artifactId       String
  /// Monotonic per-artifact version number, starting at 1.
  version          Int
  title            String
  body             String   @db.Text
  /// Optional short summary captured at publish time.
  summary          String?  @db.Text
  /// Optional changelog blurb explaining what changed in this version.
  changelog        String?  @db.Text
  createdById      String?
  createdByAgentId String?
  createdAt        DateTime @default(now())

  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifact       Artifact   @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdBy      User?      @relation("ArtifactVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByAgent Agent?     @relation("ArtifactVersionCreatorAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  currentOf      Artifact[] @relation("ArtifactCurrentVersion")

  @@unique([artifactId, version])
  @@index([workspaceId, createdAt])
}

// ----------------------------------------------------------------------------
// Agentic work OS — ContextSet primitive (added 2026-05-19, migration 0033)
// ----------------------------------------------------------------------------

/// Reusable bundle of canonical refs an agent receives as context.
/// ContextSets formalize "what did the agent see?" — items can be
/// include / exclude / summary-only. The bundle is hydrated through
/// the entity-hydration service at dispatch time and snapshotted on
/// the AgentRun (or ChatMessage) so the audit trail is durable even
/// after the set is edited.
///
/// `policy` is reserved for future controls (token budget caps, file
/// glob filters, time-window limits). For v1 it stays null.
model ContextSet {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  description  String?   @db.Text
  ownerUserId  String?
  ownerAgentId String?
  policy       Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUser      User?            @relation("ContextSetOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerAgent     Agent?           @relation("ContextSetOwnerAgent", fields: [ownerAgentId], references: [id], onDelete: SetNull)
  items          ContextSetItem[]
  executionPlans ExecutionPlan[]  @relation("ExecutionPlanContext")

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, ownerUserId])
}

/// Polymorphic ref inside a ContextSet. `targetType` matches the
/// shared entity-ref enum; `targetId` is the cuid. `includeMode` is
/// INCLUDE by default; EXCLUDE pulls a row out of the agent's view
/// even if a default rule would have pulled it in; SUMMARY_ONLY
/// includes the row but only as a one-line summary (saves tokens).
model ContextSetItem {
  id           String  @id @default(cuid())
  workspaceId  String
  contextSetId String
  targetType   String
  targetId     String
  /// INCLUDE | EXCLUDE | SUMMARY_ONLY. Free-form string so future
  /// modes don't require an enum migration.
  includeMode  String  @default("INCLUDE")
  position     Int     @default(0)
  note         String? @db.Text

  contextSet ContextSet @relation(fields: [contextSetId], references: [id], onDelete: Cascade)
  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([contextSetId, targetType, targetId])
  @@index([workspaceId, targetType, targetId])
  @@index([contextSetId, position])
}

// ----------------------------------------------------------------------------
// Agentic work OS — ExecutionPlan / ExecutionStep (added 2026-05-19, migration 0035)
// ----------------------------------------------------------------------------

/// Lifecycle for a Goal — the top-level objective the orchestrator
/// pursues. OPEN is the freshly-created state; PLANNING means a
/// PLANNER agent is decomposing it into an ExecutionPlan; ACTIVE means
/// an approved plan is running; ACHIEVED is the terminal success;
/// ABANDONED is the terminal give-up.
enum GoalStatus {
  OPEN
  PLANNING
  ACTIVE
  ACHIEVED
  ABANDONED
}

/// A top-level objective the multi-agent orchestrator pursues. A Goal
/// owns one or more ExecutionPlan attempts (only one `isActiveAttempt`
/// at a time). The decompose → approve → dispatch → judge → retry loop
/// is anchored here: budgets (`maxTotalCostUsd` / `maxWallTimeMinutes`)
/// and accumulated spend (`totalCostUsd`) gate continuation.
model Goal {
  id                 String     @id @default(cuid())
  workspaceId        String
  title              String
  description        String?    @db.Text
  status             GoalStatus @default(OPEN)
  issueId            String?
  /// Optional parent Initiative (AXI-58) — places a goal in the strategy
  /// hierarchy (Initiative → Project/Goal) so "this goal advances this bet"
  /// is expressible. Null = unparented.
  initiativeId       String?
  createdById        String?
  createdByAgentId   String?
  crewId             String?
  maxTotalCostUsd    Float?
  maxWallTimeMinutes Int?
  totalCostUsd       Float      @default(0)
  startedAt          DateTime?
  achievedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  archivedAt         DateTime?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue          Issue?          @relation(fields: [issueId], references: [id], onDelete: SetNull)
  initiative     Initiative?     @relation("InitiativeGoals", fields: [initiativeId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("GoalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByAgent Agent?          @relation("GoalCreatorAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  crew           AgentCrew?      @relation("GoalCrew", fields: [crewId], references: [id], onDelete: SetNull)
  plans          ExecutionPlan[]

  @@index([workspaceId, status])
  @@index([initiativeId])
}

/// Lifecycle for a multi-step execution plan.
enum ExecutionPlanStatus {
  DRAFT
  APPROVED
  RUNNING
  BLOCKED
  COMPLETED
  CANCELED
}

/// Lifecycle for a step inside an execution plan.
enum ExecutionStepStatus {
  TODO
  READY
  RUNNING
  BLOCKED
  REVIEW
  DONE
  CANCELED
}

/// Multi-step plan that lives under an issue, project, or freestanding.
/// Steps can be assigned to agents or humans; the runner watches the
/// plan state and surfaces ReviewGates when a step needs approval.
/// `contextSetId` ties the plan to a curated ContextSet so every step
/// shares the same canonical-ref bundle.
model ExecutionPlan {
  id                 String              @id @default(cuid())
  workspaceId        String
  title              String
  description        String?             @db.Text
  issueId            String?
  projectId          String?
  status             ExecutionPlanStatus @default(DRAFT)
  createdById        String?
  createdByAgentId   String?
  contextSetId       String?
  /// Optional pointer at an AgentCrew (added in Wave 7) that owns
  /// execution. SetNull on crew delete.
  crewId             String?
  /// Orchestration loop (migration 0051). When the plan is a decompose
  /// attempt for a Goal, `goalId` points at it. Multiple attempts per
  /// goal are allowed; only one carries `isActiveAttempt = true`.
  goalId             String?
  /// Per-step retry budget — how many times a FAILed judge verdict can
  /// re-dispatch a worker before the step is BLOCKED. Default 2.
  maxStepRetries     Int                 @default(2)
  /// Budget caps mirrored from the goal (or set per-plan). When
  /// `totalCostUsd` exceeds `maxTotalCostUsd`, or wall-time exceeds
  /// `maxWallTimeMinutes`, the watchdog BLOCKs the plan + opens a gate.
  maxTotalCostUsd    Float?
  maxWallTimeMinutes Int?
  totalCostUsd       Float               @default(0)
  /// When execution actually began — activatePlan flips DRAFT/APPROVED →
  /// RUNNING and stamps this. Wall-time budget is measured from here, NOT
  /// createdAt, so planning + approval-wait time isn't charged against the
  /// execution clock (a plan approved days after decompose shouldn't BLOCK
  /// on its first cost record). Null until first activation; legacy rows
  /// fall back to createdAt.
  startedAt          DateTime?
  /// Marks the live decompose attempt for a goal. Prior attempts are
  /// flipped false when a new decompose runs.
  isActiveAttempt    Boolean             @default(true)
  /// When true (default), a step entering REVIEW auto-dispatches a
  /// REVIEWER crew member to judge it. Opt out per-plan to require a
  /// manual `plans.judge` call.
  autoJudge          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  archivedAt         DateTime?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue          Issue?          @relation(fields: [issueId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("ExecutionPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByAgent Agent?          @relation("ExecutionPlanCreatorAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  contextSet     ContextSet?     @relation("ExecutionPlanContext", fields: [contextSetId], references: [id], onDelete: SetNull)
  crew           AgentCrew?      @relation("ExecutionPlanCrew", fields: [crewId], references: [id], onDelete: SetNull)
  goal           Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  steps          ExecutionStep[]

  @@index([workspaceId, status, updatedAt])
  @@index([issueId])
  @@index([projectId])
  @@index([contextSetId])
  @@index([crewId])
  @@index([goalId])
}

/// One step inside an ExecutionPlan. Steps form an ordered list; the
/// `dependsOnStepIds` array lets a step block on earlier steps so the
/// runner doesn't mark them READY until prerequisites are DONE.
///
/// `expectedOutput` / `verification` mirror the issue-level completion
/// contract so steps assignable to agents get the same "done means..."
/// hand-off.
model ExecutionStep {
  id               String              @id @default(cuid())
  workspaceId      String
  planId           String
  title            String
  body             String?             @db.Text
  position         Int
  status           ExecutionStepStatus @default(TODO)
  assignedAgentId  String?
  assignedUserId   String?
  expectedOutput   String?             @db.Text
  verification     Json?
  /// Pointer at the AgentRun that finished this step. Null until done.
  sourceRunId      String?
  /// Step ids this step depends on (must be DONE before READY). Empty
  /// array = no prerequisites.
  dependsOnStepIds String[]            @default([])
  /// Orchestration loop (migration 0051). The judge's verdict on this
  /// step. Shape: { verdict: "PASS"|"FAIL", feedback: string,
  /// score?: number, judgedByAgentId?: string, judgedAt: string }.
  judgeVerdict     Json?
  /// How many times this step has been re-dispatched after a FAIL.
  retryCount       Int                 @default(0)
  /// The most recent judge feedback — handed to the worker on retry so
  /// it knows what to fix. Cleared on PASS.
  lastFeedback     String?             @db.Text
  /// When this step was decomposed into a nested child ExecutionPlan,
  /// points at that child plan's id.
  childPlanId      String?
  /// Optional Issue this step has been materialized into (migration: AXI-56).
  /// Null = pure orchestration scaffolding ("Plan if desired"). When set, the
  /// step is a first-class tracked work item (board/cycle/project) and its
  /// worker run binds to this issue rather than the plan's anchor.
  issueId          String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan          ExecutionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignedAgent Agent?        @relation("ExecutionStepAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedUser  User?         @relation("ExecutionStepUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  issue         Issue?        @relation("ExecutionStepIssue", fields: [issueId], references: [id], onDelete: SetNull)
  comments      Comment[]     @relation("ExecutionStepComments")
  runs          AgentRun[]    @relation("AgentRunStep")

  @@unique([planId, position])
  @@index([workspaceId, status])
  @@index([assignedAgentId, status])
  @@index([assignedUserId, status])
  @@index([issueId])
}

// ----------------------------------------------------------------------------
// Agentic work OS — AgentCrew / ReviewGate (added 2026-05-19, migration 0036)
// ----------------------------------------------------------------------------

/// A grouping of agents that work together on plans. Crew members
/// take roles (planner/worker/reviewer/observer/operator_proxy) so a
/// plan can know which agent to ask for what.
model AgentCrew {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?   @db.Text
  /// Cap on simultaneously-running steps across the crew. 0 = unlimited.
  maxParallel Int       @default(1)
  /// Optional JSON policy blob — reserved for future controls.
  policy      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        AgentCrewMember[]
  executionPlans ExecutionPlan[]   @relation("ExecutionPlanCrew")
  goals          Goal[]            @relation("GoalCrew")
  reviewGates    ReviewGate[]      @relation("ReviewGateCrew")

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
}

/// Membership row tying an Agent into an AgentCrew with a role. The
/// same agent can hold multiple roles on the same crew (e.g.,
/// PLANNER + REVIEWER) — unique key includes the role.
model AgentCrewMember {
  id          String   @id @default(cuid())
  workspaceId String
  crewId      String
  agentId     String
  /// PLANNER | WORKER | REVIEWER | OBSERVER | OPERATOR_PROXY. Free-form
  /// string so new roles don't require enum migrations.
  role        String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  crew      AgentCrew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  agent     Agent     @relation("AgentCrewMember", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([crewId, agentId, role])
  @@index([workspaceId, agentId])
}

/// Lifecycle for a ReviewGate.
enum ReviewGateStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

/// A human/agent approval checkpoint attached to any reviewable
/// surface (artifact, execution-plan, execution-step, action-request,
/// agent-run, …). Gates block downstream automation until they
/// resolve. `requiredRole` optionally narrows who can approve.
model ReviewGate {
  id                 String           @id @default(cuid())
  workspaceId        String
  targetType         String
  targetId           String
  status             ReviewGateStatus @default(PENDING)
  /// Optional role string the resolver must satisfy (e.g., "REVIEWER",
  /// "OWNER"). Empty = anyone with workspace write can resolve.
  requiredRole       String?
  requestedById      String?
  requestedByAgentId String?
  resolvedById       String?
  resolvedByAgentId  String?
  prompt             String           @db.Text
  resolution         String?          @db.Text
  /// Optional pointer at the AgentCrew that owns this gate's
  /// resolution. Mirrors ExecutionPlan.crewId.
  crewId             String?
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?

  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy      User?      @relation("ReviewGateRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByAgent Agent?     @relation("ReviewGateRequesterAgent", fields: [requestedByAgentId], references: [id], onDelete: SetNull)
  resolvedBy       User?      @relation("ReviewGateResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedByAgent  Agent?     @relation("ReviewGateResolverAgent", fields: [resolvedByAgentId], references: [id], onDelete: SetNull)
  crew             AgentCrew? @relation("ReviewGateCrew", fields: [crewId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, targetType, targetId])
}

// ----------------------------------------------------------------------------
// Agentic work OS — ActionRequest (added 2026-05-19, migration 0037)
// ----------------------------------------------------------------------------

/// Lifecycle for an ActionRequest. OPEN is the steady state; RESOLVED
/// is the successful path; DISMISSED is the "no longer relevant"
/// path; SNOOZED parks the request until the operator chooses to act.
enum ActionRequestStatus {
  OPEN
  RESOLVED
  DISMISSED
  SNOOZED
  REJECTED
  /// Replaced by a newer request for the same (issue, kind, requester,
  /// scopePath) before it was resolved (added 2026-06-23). The newer
  /// request points back via `supersededById`. Excluded from all
  /// "waiting on you" surfaces — only the surviving request is shown.
  SUPERSEDED
}

/// Typed action kinds carried by an ActionRequest (added 2026-05-20,
/// migration 0048). FREE_FORM is the legacy default — pure prose,
/// no executable hook on Accept. The remaining kinds are executable:
/// when an authorized human Accepts, the action-request service
/// dispatches the matching operation (transition / setLabels / etc.)
/// using the `payload` Json column for kind-specific args. Reject /
/// Decline never dispatches, regardless of kind.
enum ActionRequestKind {
  FREE_FORM
  TRANSITION
  SET_LABELS
  ASSIGN
  ASSIGN_AGENT
  ARCHIVE
  CLOSE_AS_DUPLICATE
  RUNTIME_TOOL_GRANT
}

/// Agent-set confidence flag on a Comment (added 2026-05-20,
/// migration 0050). Only meaningful for agent-authored comments —
/// the UI hides the chip for human-authored rows. LOW = "I think but
/// I am not sure", MEDIUM = "reasonably confident", HIGH = "verified /
/// I ran this". Lets operators decide how much to scrutinize an
/// agent's claim before acting on it.
enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

/// Notification preference delivery mode (added 2026-05-20,
/// migration 0050). INBOX_ONLY = standard NotificationState row in
/// the inbox. INBOX_AND_DIGEST = the row also batches into the
/// (future) email/Discord digest. Digest itself is deferred; the
/// field exists so we don't migrate twice.
enum NotificationDelivery {
  INBOX_ONLY
  INBOX_AND_DIGEST
}

/// A precise, resolvable ask. Replaces vague notifications: instead of
/// "the agent commented", ActionRequest models "the agent needs your
/// decision before continuing." Inbox's waiting-on-me query unions
/// these with the existing NotificationState lifecycle.
model ActionRequest {
  id                 String               @id @default(cuid())
  workspaceId        String
  title              String
  body               String?              @db.Text
  status             ActionRequestStatus  @default(OPEN)
  severity           NotificationSeverity @default(INFO)
  /// Discriminator for the executable action (if any) bundled with this
  /// request. FREE_FORM (default) is a pure ask with no dispatch hook.
  /// Other kinds carry their args in `payload` and run on Accept.
  kind               ActionRequestKind    @default(FREE_FORM)
  /// Kind-specific args. Shape varies by `kind`:
  ///   TRANSITION         → { statusId: string }
  ///   SET_LABELS         → { add?: string[]; remove?: string[] }
  ///   ASSIGN             → { userIds: string[] }
  ///   ASSIGN_AGENT       → { agentId: string }
  ///   ARCHIVE            → {} (no args needed; targets `issueId`)
  ///   CLOSE_AS_DUPLICATE → { duplicateOfIssueId: string; statusId?: string }
  ///   RUNTIME_TOOL_GRANT → { agentId, mode, tools, accessLevel, scopePath, reason? }
  /// Validated at create time by the action-request service; rejected
  /// if any referenced id lives outside the workspace.
  payload            Json?
  /// Optional poll options (added 2026-05-20, migration 0050). When
  /// non-null, the renderer treats this request as a poll — operators
  /// vote via ActionRequestVote and the requester closes voting to
  /// surface the winning option. Shape:
  ///   `[{ key: string, label: string, description?: string }]`
  /// `key` is the stable identifier carried by every vote row.
  options            Json?
  /// Set when the original requester closes voting (added 2026-05-20,
  /// migration 0050). Once set, ActionRequestVote upserts are rejected.
  /// Null means voting is still open.
  votingClosedAt     DateTime?
  requestedByUserId  String?
  requestedByAgentId String?
  assignedUserId     String?
  assignedAgentId    String?
  /// Polymorphic source — chat-message, comment, agent-run, etc.
  sourceType         String?
  sourceId           String?
  /// Optional pointer at the issue this request relates to. Lets the
  /// inbox surface group requests under their parent issue without
  /// re-deriving from sourceType.
  issueId            String?
  dueAt              DateTime?
  resolvedAt         DateTime?
  resolvedByUserId   String?
  resolution         String?              @db.Text
  /// Set when a newer request for the same dedup key replaced this one
  /// (added 2026-06-23). Points at the surviving request; this row's
  /// `status` becomes SUPERSEDED. Lets the UI render "replaces #N" /
  /// escalation lineage (e.g. read-only → full grant on AXI-26).
  supersededById     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedByUser  User?               @relation("ActionRequestRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedByAgent Agent?              @relation("ActionRequestRequesterAgent", fields: [requestedByAgentId], references: [id], onDelete: SetNull)
  assignedUser     User?               @relation("ActionRequestAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedAgent    Agent?              @relation("ActionRequestAssigneeAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  resolvedByUser   User?               @relation("ActionRequestResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  issue            Issue?              @relation(fields: [issueId], references: [id], onDelete: SetNull)
  supersededBy     ActionRequest?      @relation("ActionRequestSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       ActionRequest[]     @relation("ActionRequestSupersede")
  votes            ActionRequestVote[]

  @@index([workspaceId, status, createdAt])
  @@index([assignedUserId, status])
  @@index([assignedAgentId, status])
  @@index([issueId])
  @@index([sourceType, sourceId])
  @@index([supersededById])
}

/// Per-user vote on a poll-style ActionRequest (added 2026-05-20,
/// migration 0050). Unique on `(actionRequestId, userId)` so each
/// user votes once per request; changing your pick is an upsert.
/// `optionKey` references one of the strings in `ActionRequest.options[].key`.
model ActionRequestVote {
  id              String   @id @default(cuid())
  actionRequestId String
  userId          String
  optionKey       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actionRequest ActionRequest @relation(fields: [actionRequestId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([actionRequestId, userId])
  @@index([actionRequestId, optionKey])
  @@index([userId])
}

/// Per-user opt-out for an EventKind (added 2026-05-20, migration
/// 0050). When no row exists, the kind is treated as enabled — so
/// existing users see no behavior change until they explicitly opt
/// out. `workspaceId` is nullable: a null row applies across every
/// workspace the user belongs to (a global "never page me about
/// this"). A workspace-scoped row overrides the global default for
/// that workspace.
model NotificationPreference {
  id          String               @id @default(cuid())
  userId      String
  workspaceId String?
  eventKind   String
  enabled     Boolean              @default(true)
  delivery    NotificationDelivery @default(INBOX_ONLY)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CASCADE rather than SET NULL: workspace-scoped prefs are
  /// meaningless once the workspace is gone, and SET NULL would
  /// collide with the partial unique index when the user already has
  /// a global pref for the same (user, eventKind). Cascading lets
  /// the global row survive untouched.
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, eventKind])
  @@index([workspaceId, eventKind])
  @@index([userId, eventKind])
}

// ----------------------------------------------------------------------------
// Agentic work OS — WorkspaceCanvas (added 2026-05-19, migration 0038)
// ----------------------------------------------------------------------------

/// Infinite spatial canvas for synthesis work — operators arrange
/// existing entities on a 2D plane to make sense of in-progress work.
/// Canvas stores layout + entity refs only; canonical content lives
/// on the source row so a canvas can never become a second source of
/// truth.
///
/// `scopeType` / `scopeId` optionally anchor the canvas under an
/// issue / project / initiative / user / workspace. Workspace-scope
/// is the default (canvas with no anchor).
model WorkspaceCanvas {
  id           String     @id @default(cuid())
  workspaceId  String
  name         String
  /// Discriminator. Anchored canvases (PROJECT/INITIATIVE/CYCLE/ISSUE)
  /// carry `scopeType` + `scopeId`. PERSONAL = the per-user dashboard
  /// canvas (`ownerUserId` set). DESIGN = multi-page Figma-style canvas
  /// (`activePageId` tracks the currently-active top-level frame).
  /// Existing rows default to PROJECT to preserve current behavior;
  /// the kind is set explicitly at create time going forward.
  kind         CanvasKind @default(PROJECT)
  scopeType    String?
  scopeId      String?
  /// Owner for PERSONAL canvases. Null for shared / anchored canvases.
  /// Cascades on user delete (personal canvases vanish with the user).
  ownerUserId  String?
  /// Currently-active page id for DESIGN canvases — points at a
  /// `CanvasFrame` row with `isPage = true`. Null for single-page
  /// canvases.
  activePageId String?
  viewport     Json?
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  archivedAt   DateTime?

  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User?                     @relation("WorkspaceCanvasCreator", fields: [createdById], references: [id], onDelete: SetNull)
  owner              User?                     @relation("WorkspaceCanvasOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  nodes              WorkspaceCanvasNode[]
  edges              WorkspaceCanvasEdge[]
  shapes             CanvasShape[]
  frames             CanvasFrame[]
  groups             CanvasGroup[]
  componentInstances CanvasComponentInstance[]

  @@unique([workspaceId, kind, ownerUserId])
  @@index([workspaceId, scopeType, scopeId])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, kind])
  @@index([ownerUserId])
}

/// A card on the canvas. `targetType` + `targetId` references a
/// canonical entity (issue/artifact/chat-thread/attachment/agent-run/
/// execution-plan/execution-step). The cuid is workspaceId-scoped at
/// fetch time via the entity-hydration service; deleted-target rows
/// surface as dead-ref placeholders rather than disappearing.
model WorkspaceCanvasNode {
  id            String    @id @default(cuid())
  workspaceId   String
  canvasId      String
  targetType    String
  targetId      String
  x             Float
  y             Float
  width         Float
  height        Float
  zIndex        Int       @default(0)
  collapsed     Boolean   @default(false)
  /// card | full | compact | live. Free-form string so views don't
  /// require enum migration.
  viewMode      String?
  meta          Json?
  /// Optional parent CanvasFrame (a frame that owns this node — moves
  /// + auto-layout cascade). SetNull on frame delete so the node
  /// survives frame churn (becomes a free-floating node).
  parentFrameId String?
  /// Optional CanvasGroup the node belongs to. Groups are transform
  /// containers (non-visual). SetNull on group dissolve.
  groupId       String?
  /// Style references — opaque map of `{ fill?: styleId, text?: styleId,
  /// effect?: styleId }`. Applied on render; missing keys fall back to
  /// the node's `meta` defaults.
  styleRefs     Json?
  /// Set when the node is locked from edits in the layers panel. The
  /// canvas honors lockedAt by disabling drag/resize/edit gestures.
  lockedAt      DateTime?
  /// Set when the node is hidden in the layers panel. Hidden nodes are
  /// not rendered on the canvas but persist in the data model.
  hiddenAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  canvas      WorkspaceCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  parentFrame CanvasFrame?    @relation("CanvasFrameNodes", fields: [parentFrameId], references: [id], onDelete: SetNull)
  group       CanvasGroup?    @relation("CanvasGroupNodes", fields: [groupId], references: [id], onDelete: SetNull)

  @@index([canvasId, zIndex])
  @@index([workspaceId, targetType, targetId])
  @@index([parentFrameId])
  @@index([groupId])
}

/// A directional edge between two canvas nodes — used to draw
/// connections / relations between cards. Optional label / kind for
/// labeled arrows.
model WorkspaceCanvasEdge {
  id          String   @id @default(cuid())
  workspaceId String
  canvasId    String
  fromNodeId  String
  toNodeId    String
  label       String?
  kind        String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  canvas    WorkspaceCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@index([canvasId])
}

/// Excalidraw-style drawing primitive on a canvas. Unlike
/// WorkspaceCanvasNode, shapes don't reference Forge entities — they
/// are pure visual annotations (boxes, ellipses, arrows, text,
/// freehand strokes) for ideation and grouping. Shapes with the same
/// `groupId` are manipulated together.
model CanvasShape {
  id            String    @id @default(cuid())
  workspaceId   String
  canvasId      String
  /// box | ellipse | line | arrow | text | freehand
  kind          String
  /// Position. For bounded shapes (box/ellipse/text): x,y,width,height.
  /// For path shapes (line/arrow/freehand): start at (x,y); points
  /// stored in `path` JSON as an array of relative (dx, dy) tuples.
  x             Float
  y             Float
  width         Float?
  height        Float?
  path          Json?
  /// Style. stroke, fill, strokeWidth, dasharray, fontSize, color,
  /// fontWeight, opacity. Free-form for v1; can tighten later.
  style         Json?
  /// Optional text content for text + arrow-label shapes.
  text          String?   @db.Text
  zIndex        Int       @default(0)
  /// Optional grouping. Two layers:
  ///   - Legacy `groupId` (free-form string) lets shapes share a
  ///     transient transform group without a backing row.
  ///   - `canvasGroupId` (added with the unified-workspace migration)
  ///     points at a first-class `CanvasGroup` row that can hold
  ///     mixed shape + node + frame children. New code prefers this.
  groupId       String?
  canvasGroupId String?
  /// Optional parent CanvasFrame (a frame that owns this shape — moves
  /// + auto-layout cascade). SetNull on frame delete.
  parentFrameId String?
  /// Style references — opaque map of `{ fill?: styleId, text?: styleId,
  /// effect?: styleId }`. Applied on render.
  styleRefs     Json?
  /// Set when the shape is locked from edits in the layers panel.
  lockedAt      DateTime?
  /// Set when the shape is hidden in the layers panel.
  hiddenAt      DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  canvas      WorkspaceCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("CanvasShapeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parentFrame CanvasFrame?    @relation("CanvasFrameShapes", fields: [parentFrameId], references: [id], onDelete: SetNull)
  canvasGroup CanvasGroup?    @relation("CanvasGroupShapes", fields: [canvasGroupId], references: [id], onDelete: SetNull)

  @@index([canvasId, zIndex])
  @@index([workspaceId])
  @@index([parentFrameId])
  @@index([canvasGroupId])
}

// ----------------------------------------------------------------------------
// Canvas Figma primitives — frames, groups, components, styles
// (added with the unified-workspace-flow plan, migration 0046)
// ----------------------------------------------------------------------------

/// A named bounded region on a canvas that owns its children (nodes /
/// shapes / instances / nested frames). Frames are first-class — not a
/// shape variant — so they can carry auto-layout config, act as pages
/// for DESIGN canvases (`isPage = true`), and host constraints.
///
/// Children reference the frame via their `parentFrameId`. Dragging
/// the frame moves all children; resizing the frame doesn't resize
/// children unless `autoLayout` is set.
model CanvasFrame {
  id             String    @id @default(cuid())
  workspaceId    String
  canvasId       String
  /// Nested frame parent. Null = top-level. Frames can nest arbitrarily.
  parentFrameId  String?
  /// Display name shown in the title bar + layers panel.
  name           String    @default("Frame")
  x              Float
  y              Float
  width          Float
  height         Float
  /// When true, this frame is a top-level "page" for DESIGN canvases.
  /// The active page id lives on `WorkspaceCanvas.activePageId`.
  isPage         Boolean   @default(false)
  /// Auto-layout config — `{ direction: "horizontal"|"vertical", gap,
  /// paddingTop, paddingRight, paddingBottom, paddingLeft, align:
  /// "start"|"center"|"end", justify: "start"|"center"|"end"|
  /// "space-between" }`. Null = free positioning.
  autoLayout     Json?
  /// Per-frame constraints applied to children on resize: `{ horizontal:
  /// "left"|"right"|"center"|"scale", vertical: "top"|"bottom"|"center"
  /// |"scale" }`. Honored only when `autoLayout` is null.
  constraints    Json?
  /// Optional background fill: `{ color?, opacity?, styleId? }`.
  backgroundFill Json?
  z              Int       @default(0)
  lockedAt       DateTime?
  hiddenAt       DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  canvas      WorkspaceCanvas           @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  parentFrame CanvasFrame?              @relation("CanvasFrameNesting", fields: [parentFrameId], references: [id], onDelete: SetNull)
  childFrames CanvasFrame[]             @relation("CanvasFrameNesting")
  nodes       WorkspaceCanvasNode[]     @relation("CanvasFrameNodes")
  shapes      CanvasShape[]             @relation("CanvasFrameShapes")
  groups      CanvasGroup[]             @relation("CanvasFrameGroups")
  instances   CanvasComponentInstance[] @relation("CanvasFrameInstances")
  createdBy   User?                     @relation("CanvasFrameCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([canvasId, parentFrameId, z])
  @@index([canvasId, isPage])
  @@index([workspaceId])
}

/// A non-visual transform container — group multiple children so they
/// move/resize/copy as a unit. Distinct from `CanvasFrame` which is a
/// visual region with a title bar and optional auto-layout.
///
/// Members reference the group via `groupId` (nodes), `canvasGroupId`
/// (shapes), or `groupId` on instances/nested groups. SetNull on group
/// dissolve so members survive.
model CanvasGroup {
  id            String    @id @default(cuid())
  workspaceId   String
  canvasId      String
  parentFrameId String?
  name          String    @default("Group")
  z             Int       @default(0)
  lockedAt      DateTime?
  hiddenAt      DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  canvas      WorkspaceCanvas           @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  parentFrame CanvasFrame?              @relation("CanvasFrameGroups", fields: [parentFrameId], references: [id], onDelete: SetNull)
  nodes       WorkspaceCanvasNode[]     @relation("CanvasGroupNodes")
  shapes      CanvasShape[]             @relation("CanvasGroupShapes")
  instances   CanvasComponentInstance[] @relation("CanvasGroupInstances")
  createdBy   User?                     @relation("CanvasGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([canvasId, parentFrameId, z])
  @@index([workspaceId])
}

/// Workspace-scoped reusable component definition. Components are
/// snapshots of a node/shape/frame subtree; placing one on a canvas
/// creates a `CanvasComponentInstance` that renders the definition
/// with optional per-instance overrides.
///
/// "Update component" pushes the current state of an instance back to
/// `definition`, refreshing other instances (overrides preserved where
/// paths still exist). "Detach instance" expands the definition into
/// raw rows under the host frame.
model CanvasComponent {
  id          String    @id @default(cuid())
  workspaceId String
  /// Unique per workspace — duplicates are rejected at create time.
  name        String
  description String?   @db.Text
  /// Optional thumbnail data URL or asset key. Rendered in the
  /// components panel for drag-onto-canvas.
  thumbnail   String?   @db.Text
  /// Snapshot tree: `{ nodes: [...], shapes: [...], frames: [...],
  /// edges: [...], width, height }`. Opaque to the schema layer; the
  /// client renders + diffs against this.
  definition  Json
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?                     @relation("CanvasComponentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  instances CanvasComponentInstance[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt, updatedAt])
}

/// Placed instance of a `CanvasComponent` on a specific canvas.
/// `overrides` is a sparse JSON diff (path → value) applied to the
/// component definition at render time. Detaching the instance
/// expands the definition into raw nodes/shapes/frames and deletes
/// this row.
model CanvasComponentInstance {
  id            String    @id @default(cuid())
  workspaceId   String
  canvasId      String
  componentId   String
  parentFrameId String?
  groupId       String?
  x             Float
  y             Float
  width         Float
  height        Float
  /// Sparse override map keyed by node path inside the definition.
  /// e.g. `{ "nodes.0.text": "Hi", "shapes.2.style.fill": "#fff" }`.
  /// Empty = pure instance.
  overrides     Json?
  z             Int       @default(0)
  lockedAt      DateTime?
  hiddenAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  canvas      WorkspaceCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  component   CanvasComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  parentFrame CanvasFrame?    @relation("CanvasFrameInstances", fields: [parentFrameId], references: [id], onDelete: SetNull)
  group       CanvasGroup?    @relation("CanvasGroupInstances", fields: [groupId], references: [id], onDelete: SetNull)

  @@index([canvasId, z])
  @@index([componentId])
  @@index([parentFrameId])
  @@index([groupId])
  @@index([workspaceId])
}

/// Workspace-scoped reusable style — color, text, or effect preset.
/// Nodes / shapes / frames reference a CanvasStyle via their
/// `styleRefs` JSON so edits cascade to every consumer.
model CanvasStyle {
  id          String          @id @default(cuid())
  workspaceId String
  kind        CanvasStyleKind
  name        String
  /// Opaque value JSON:
  ///   COLOR  -> `{ hex, opacity? }` or `{ tokens: ["bg-card", ...] }`
  ///   TEXT   -> `{ family, size, weight, lineHeight?, letterSpacing?,
  ///              color? }`
  ///   EFFECT -> `{ shadow?: {...}, blur?: {...}, opacity? }`
  value       Json
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CanvasStyleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, kind, name])
  @@index([workspaceId, kind])
  @@index([workspaceId, archivedAt])
}

# ---- Forge environment ----
# Copy to .env and fill in.

# Core
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — Postgres
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge?schema=public

# Redis (pub/sub, BullMQ, rate limiting)
REDIS_URL=redis://localhost:6379

# Auth — NextAuth v5
# AUTH_SECRET also keys the AES-256-GCM encryption of stored SSO client
# secrets (src/server/crypto.ts) — rotating it invalidates them, so re-enter
# providers in Settings → Authentication after a rotation.
AUTH_SECRET=change-me-to-32-random-bytes
AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.local   # the instance admin (manages SSO providers)

# OAuth providers are now managed in the UI (Settings → Authentication),
# stored in the SsoProvider table. These env vars are OPTIONAL bootstrap
# only: if set and no matching DB row exists yet, a provider row is seeded
# from them on first boot. After that, manage everything in the UI.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email (magic links)
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=noreply@forge.local

# Plugin / agent authentication
PLUGIN_JWT_ISSUER=forge
PLUGIN_JWT_AUDIENCE=forge-plugins
PLUGIN_JWT_SECRET=change-me-plugin-signing-key

# MCP — Model Context Protocol endpoint auth
MCP_PUBLIC_BASE=http://localhost:3000/api/mcp

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Feature flags
FEATURE_PLUGINS=true
FEATURE_REALTIME=true

# ---- AI features (optional) ----
# Forge-internal AI: triage on issue create + Coach diagnostic comments
# on stalls / no-acks / SLA breaches. Per-workspace toggles live in
# /settings/workspace. Provider is per-workspace too — default `hermes`.
#
# Provider env vars (only the active provider's vars need to be set):
#
#   hermes (default)  HERMES_GATEWAY_URL (default http://127.0.0.1:8642/v1)
#                     HERMES_GATEWAY_TOKEN
#   openai            OPENAI_API_KEY  (+ optional OPENAI_BASE_URL for
#                                       OpenRouter / vLLM / etc.)
#   anthropic         ANTHROPIC_API_KEY
#   custom            FORGE_AI_BASE_URL + FORGE_AI_API_KEY
#
# Hermes is preferred — it routes via the model-router plugin so you
# don't have to manage upstream provider keys here.
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1
HERMES_GATEWAY_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FORGE_AI_BASE_URL=
FORGE_AI_API_KEY=

# ---- Object storage (S3 / MinIO) ----
# Forge stores attachments in an S3-compatible bucket per workspace.
# In dev we run MinIO via docker/docker-compose.yml:
#
#   docker compose -f docker/docker-compose.yml up -d minio
#
# Then open the web console at http://localhost:59001 and log in with
# the MINIO_ROOT_USER / MINIO_ROOT_PASSWORD baked into compose
# (forgeminio / forgeminio-dev-password). Buckets are created lazily
# by the app on first attachment upload — no manual setup needed.
#
# MinIO uses its root credentials as the S3 access key / secret, so the
# values below MUST match docker-compose.yml's MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD.
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=forgeminio
S3_SECRET_KEY=forgeminio-dev-password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
